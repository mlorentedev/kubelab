# --- Staging zones (from networking.staging_zones in common.yaml) ---

staging.kubelab.live {
    # The apex only: the template below answers every name under it with the same
    # address. A per-service line here added nothing but a 3600s TTL, which pinned
    # retired names (web, blog, gitea) in Pi-hole for an hour (#2219).
    hosts {
        100.64.0.11 staging.kubelab.live
        fallthrough
    }
    template IN A staging.kubelab.live {
        match .*\.staging\.kubelab\.live
        answer "{{ .Name }} 60 IN A 100.64.0.11"
        fallthrough
    }
    # Every other type for those names: an empty NOERROR with the zone's SOA
    # (NODATA, RFC 2308). Without it the chain ends with no handler and answers
    # SERVFAIL, and musl (Alpine, busybox) asks A and AAAA together and fails the
    # whole lookup when either fails: staging Vikunja could not resolve auth for
    # eight days (DNS-005, #2711). The SOA's last field caps how long a resolver
    # caches the empty answer. `fallthrough` is load-bearing: the apex matches no
    # pattern and must still reach `hosts`.
    template IN ANY staging.kubelab.live {
        match .*\.staging\.kubelab\.live
        rcode NOERROR
        authority "staging.kubelab.live. 60 IN SOA ns.staging.kubelab.live. hostmaster.staging.kubelab.live. 1 7200 1800 1209600 60"
        fallthrough
    }
    log
    errors
}

staging.mlorente.dev {
    hosts {
        100.64.0.11 staging.mlorente.dev
        fallthrough
    }
    log
    errors
}

staging.imagesensortool.com {

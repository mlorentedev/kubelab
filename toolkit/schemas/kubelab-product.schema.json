{
  "$defs": {
    "Hostnames": {
      "additionalProperties": false,
      "description": "The public hostname of the product in each kubelab environment it runs in.\n\n``staging`` is required: every product lands there first. ``prod`` is declared\nonce the product has a prod lane (``events.prod`` in the registry); a product\nthat has none yet omits it.",
      "properties": {
        "prod": {
          "anyOf": [
            {
              "maxLength": 253,
              "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hostname served by the prod cluster, e.g. example.dev. Omit it until the product has a prod lane.",
          "title": "Prod"
        },
        "staging": {
          "description": "Hostname served by the staging cluster, e.g. staging.example.dev.",
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Staging",
          "type": "string"
        }
      },
      "required": [
        "staging"
      ],
      "title": "Hostnames",
      "type": "object"
    },
    "JobClaim": {
      "additionalProperties": false,
      "description": "``type: job``: a scheduled task.",
      "properties": {
        "class": {
          "const": "cron",
          "default": "cron",
          "description": "Job kind; only cron today.",
          "title": "Class",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/JobParams"
        },
        "type": {
          "const": "job",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "params"
      ],
      "title": "JobClaim",
      "type": "object"
    },
    "JobParams": {
      "additionalProperties": false,
      "description": "A scheduled run of the product's image (a CronJob; concurrency Forbid, two retries).",
      "properties": {
        "active_deadline_seconds": {
          "default": 3600,
          "description": "A run still going after this many seconds is stopped.",
          "maximum": 86400,
          "minimum": 1,
          "title": "Active Deadline Seconds",
          "type": "integer"
        },
        "command": {
          "description": "Argv the job runs, e.g. [resume, daily]; no shell.",
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "schedule": {
          "description": "Five-field cron schedule, in UTC.",
          "maxLength": 100,
          "pattern": "^[0-9*/,-]+( [0-9*/,-]+){4}$",
          "title": "Schedule",
          "type": "string"
        },
        "volume": {
          "description": "Name of a volume claim in this contract the job mounts.",
          "maxLength": 31,
          "pattern": "^[a-z][a-z0-9-]{0,30}$",
          "title": "Volume",
          "type": "string"
        }
      },
      "required": [
        "schedule",
        "command",
        "volume"
      ],
      "title": "JobParams",
      "type": "object"
    },
    "VolumeClaim": {
      "additionalProperties": false,
      "description": "``type: volume``: storage that outlives a pod.",
      "properties": {
        "class": {
          "const": "local",
          "default": "local",
          "description": "Storage class; only local today.",
          "title": "Class",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/VolumeParams"
        },
        "type": {
          "const": "volume",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "params"
      ],
      "title": "VolumeClaim",
      "type": "object"
    },
    "VolumeParams": {
      "additionalProperties": false,
      "description": "A persistent volume the product's containers mount (one PVC per claim, RWO).",
      "properties": {
        "fs_group": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Group id the pod's volumes are owned by; set it to the image's non-root group.",
          "title": "Fs Group"
        },
        "mount_path": {
          "description": "Absolute path in the container.",
          "maxLength": 256,
          "pattern": "^(/[A-Za-z0-9_][A-Za-z0-9._-]*)+$",
          "title": "Mount Path",
          "type": "string"
        },
        "size": {
          "description": "Positive whole quantity, e.g. 1Gi.",
          "maxLength": 32,
          "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$",
          "title": "Size",
          "type": "string"
        }
      },
      "required": [
        "size",
        "mount_path"
      ],
      "title": "VolumeParams",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/mlorentedev/kubelab/master/toolkit/schemas/kubelab-product.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a product declares about itself to be deployed on kubelab.",
  "properties": {
    "auth": {
      "description": "public: no auth; forwardauth: Authelia in front of every request; forwardauth-admins: the same, limited to the admins group; oidc: the app is an OIDC client.",
      "enum": [
        "public",
        "forwardauth",
        "forwardauth-admins",
        "oidc"
      ],
      "title": "Auth",
      "type": "string"
    },
    "health_path": {
      "description": "HTTP path that answers 2xx when the container is healthy.",
      "maxLength": 256,
      "pattern": "^/[A-Za-z0-9._~/-]*$",
      "title": "Health Path",
      "type": "string"
    },
    "hostnames": {
      "$ref": "#/$defs/Hostnames"
    },
    "image": {
      "description": "Image repository without tag or digest; kubelab pins the tag it deploys.",
      "maxLength": 255,
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+$",
      "title": "Image",
      "type": "string"
    },
    "port": {
      "description": "Port the container listens on inside the cluster.",
      "maximum": 65535,
      "minimum": 1,
      "title": "Port",
      "type": "integer"
    },
    "resources": {
      "description": "Platform resources the product claims, by name: a volume, a scheduled job. Optional.",
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,30}$": {
          "discriminator": {
            "mapping": {
              "job": "#/$defs/JobClaim",
              "volume": "#/$defs/VolumeClaim"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/VolumeClaim"
            },
            {
              "$ref": "#/$defs/JobClaim"
            }
          ]
        }
      },
      "propertyNames": {
        "maxLength": 31
      },
      "title": "Resources",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "description": "Version of this schema the contract is written against.",
      "title": "Schema Version",
      "type": "integer"
    },
    "secrets": {
      "description": "Names of the secrets the product expects. Values never appear here; the operator sets them.",
      "items": {
        "maxLength": 200,
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
        "type": "string"
      },
      "title": "Secrets",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "image",
    "port",
    "health_path",
    "hostnames",
    "auth"
  ],
  "title": "kubelab product contract",
  "type": "object"
}

# The pre-runner Make targets rendered this here with `billing_account_id` in it.
# The runner passes that value as TF_VAR_billing_account_id and removes any copy
# it finds, but a checkout older than TF-007 may still hold one; this line keeps
# it out of `git add -A`.
gcp-bootstrap.tfvars
.terraform/
*.tfstate
*.tfstate.backup

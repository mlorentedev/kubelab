# --- Staging zones (from networking.staging_zones in common.yaml) ---

{{ staging_domain }} {
    # The apex only: the template below answers every name under it with the same
    # address. A per-service line here added nothing but a 3600s TTL, which pinned
    # retired names (web, blog, gitea) in Pi-hole for an hour (#2219).
    hosts {
        {{ node_ips.ace1 }} {{ staging_domain }}
        fallthrough
    }
    template IN A {{ staging_domain }} {
        match .*\.{{ staging_domain | regex_escape }}
        answer "{% raw %}{{ .Name }}{% endraw %} 60 IN A {{ node_ips.ace1 }}"
        fallthrough
    }
    log
    errors
}

{% for zone in staging_zones %}
{% if zone != staging_domain %}
{{ zone }} {
    hosts {
        {{ node_ips.ace1 }} {{ zone }}
        fallthrough
    }
    log
    errors
}

{% endif %}
{% endfor %}
# --- Prod zone ---

{{ base_domain }} {
    hosts {
        # Bare-metal services: individual Tailscale IPs
        {{ node_ips.jetson }} {{ service_domains.jetson | default('jetson.' + base_domain) }}
        # Every prod record Cloudflare publishes (infra/terraform/dns/services.json),
        # at the same target over the tailnet: the VPS unless the record names a
        # node. Rendered from that list, never kept by hand: a hand list sent
        # status.kubelab.live to rpi3, where nothing serves 443 (#2212). LAN
        # clients arrive from 100.64.0.0/10, which Authelia and CrowdSec trust.
        {{ node_ips.vps }} {{ base_domain }}
        {{ node_ips.vps }} www.{{ base_domain }}
{% for record in coredns_public_records
      if record.zone == 'kubelab' and 'prod' in record.environments
      and (record.name ~ '.' ~ base_domain) != service_domains.vpn %}
        {{ node_ips[record.target] if record.target is defined else node_ips.vps }} {{ record.name }}.{{ base_domain }}
{% endfor %}
        # Headscale MUST use public IP — bootstrap dependency
        {{ vps_public_ip }} {{ service_domains.vpn }}
        fallthrough
    }
    forward . 1.1.1.1 8.8.8.8
    log
    errors
}

. {
    forward . 1.1.1.1 8.8.8.8
    cache 30
    log
    errors
    # Liveness/readiness over HTTP, because this image cannot be probed any other
    # way: coredns/coredns is distroless (entrypoint /coredns, no shell, no dig),
    # so every `exec`-based Docker healthcheck fails on a missing binary rather
    # than on CoreDNS being unwell. See the compose template.
    health :8080
    ready :8181
}

# Managed by Ansible — do not edit manually
# Source: infra/ansible/roles/coredns/templates/docker-compose.yml.j2
services:
  pihole:
    container_name: pihole
    image: {{ pihole_image }}
    restart: {{ restart_policy }}
    ports:
      - "{{ pihole_port }}:53/udp"
      - "{{ pihole_port }}:53/tcp"
      - "{{ pihole_web_port }}:80/tcp"
    volumes:
      - pihole_data:/etc/pihole
      - ./pihole-forwarding.conf:/etc/dnsmasq.d/pihole-forwarding.conf:ro
    environment:
      - TZ={{ pihole_timezone }}
    healthcheck:
      test: ["CMD", "dig", "@127.0.0.1", "localhost", "+short"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  coredns:
    container_name: coredns
    image: {{ coredns_image }}
    restart: {{ restart_policy }}
    ports:
      - "{{ coredns_port }}:53/udp"
      - "{{ coredns_port }}:53/tcp"
      # Health endpoint from the `health` plugin. Bound to the Tailscale address,
      # never published bare: Docker's DNAT is evaluated before ufw's filter
      # chains and DOCKER-USER is empty fleet-wide, so a published port is
      # governed by its bind address and nothing else (#959).
      - "{{ node_ips.rpi4 }}:{{ coredns_health_port }}:8080/tcp"
    volumes:
      - ./Corefile:/etc/coredns/Corefile:ro
    command: ["-conf", "/etc/coredns/Corefile"]
    # NO healthcheck: block. This is deliberate, and removing a check is the fix.
    #
    # coredns/coredns is distroless — entrypoint /coredns, no /bin/sh, no dig.
    # The previous check was ["CMD", "dig", ...], which cannot run in this image
    # under any circumstances. It had failed 996 consecutive times, and that is
    # worse than having no check at all: a probe that has never passed is
    # indistinguishable from a service that has never worked, so the one real
    # CoreDNS outage this was meant to catch would arrive at an indicator that
    # was already red. Docker healthchecks run *inside* the container, so no
    # in-container probe is possible here; the signal moves out instead, to the
    # `health`/`ready` endpoints published above.

volumes:
  pihole_data:

# {{ ansible_managed }}
# Starts what the uplink needs each time its adapter appears, so a replug or a USB
# reset brings the uplink back without a reboot (#2766). netplan starts the
# supplicant only with systemd-networkd at boot. systemd acts on SYSTEMD_WANTS only
# when the device first becomes active, so a missing adapter pulls in nothing.
# Every event but remove carries it: the add event renames the adapter and is
# flagged ID_RENAMING, which systemd ignores, so the device becomes active on the
# move event that follows. A rule on ACTION=="add" alone started nothing (#2766).
# Sorts after 80-net-setup-link.rules, which gives the adapter its name from
# 10-kubelab-uplink.link: NAME== matches nothing before it.
{% if gateway_uplink_kind == 'ethernet' %}
ACTION!="remove", SUBSYSTEM=="net", NAME=="{{ gateway_uplink_interface }}", ENV{SYSTEMD_WANTS}+="kubelab-edge-shaper.service"
{% else %}
ACTION!="remove", SUBSYSTEM=="net", NAME=="{{ gateway_uplink_interface }}", ENV{SYSTEMD_WANTS}+="netplan-wpa-{{ gateway_uplink_interface }}.service kubelab-edge-shaper.service"
{% endif %}

# {{ ansible_managed }}
# Shapes the uplink with CAKE in both directions (NET-005 AC8), so a bulk transfer
# from one host does not starve a call on another. Egress is shaped on the uplink
# with fairness between source hosts. Ingress is redirected to an IFB device and
# shaped as it leaves it, with fairness between destination hosts. `nat` makes CAKE
# read conntrack, so it sees the lab's hosts rather than the one masqueraded
# address. The rates come from the site profile, already set below the measured
# ones, so the queue forms here and not in the site's equipment.
[Unit]
Description=Shape the edge uplink with CAKE
# The qdiscs die with the device: the unit stops with it, and the udev rule
# (90-kubelab-uplink.rules) starts it again when a replugged adapter comes back.
# Never installed into the device's .wants/: systemd follows a link there whenever a
# start job for the device is enqueued, so a missing adapter failed this unit with
# result `dependency` every 90 s (#2766).
BindsTo=sys-subsystem-net-devices-{{ gateway_uplink_interface }}.device
After=sys-subsystem-net-devices-{{ gateway_uplink_interface }}.device
OnFailure=kubelab-notify@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
# `ip` and `tc` take milliseconds. A oneshot has no start timeout unless it sets
# one, and its start job holds the boot (#2786).
TimeoutStartSec=30
# No KUBELAB_NOTIFY_SEVERITY: a failure leaves the uplink unshaped, not down,
# so it posts at the host's `log` (#2684).
# Clear what the last start left: a restart would otherwise stack a second
# redirect filter, and `ip link add` would fail on the IFB that already exists.
ExecStartPre=-/usr/sbin/tc qdisc del dev {{ gateway_uplink_interface }} ingress
ExecStartPre=-/usr/sbin/ip link del {{ gateway_uplink_ifb }}
# The IFB is shaped and up before anything is redirected to it.
ExecStart=/usr/sbin/ip link add {{ gateway_uplink_ifb }} type ifb
ExecStart=/usr/sbin/tc qdisc replace dev {{ gateway_uplink_ifb }} root cake bandwidth {{ gateway_uplink_down_kbit }}kbit nat dual-dsthost ingress
ExecStart=/usr/sbin/ip link set {{ gateway_uplink_ifb }} up
ExecStart=/usr/sbin/tc qdisc replace dev {{ gateway_uplink_interface }} root cake bandwidth {{ gateway_uplink_up_kbit }}kbit nat dual-srchost
ExecStart=/usr/sbin/tc qdisc add dev {{ gateway_uplink_interface }} handle ffff: ingress
ExecStart=/usr/sbin/tc filter add dev {{ gateway_uplink_interface }} parent ffff: matchall action mirred egress redirect dev {{ gateway_uplink_ifb }}
# Closes the incident a failed start opened (#2689). Not OnSuccess=: on a
# RemainAfterExit unit that fires when the unit stops, which here is every unplug.
ExecStartPost=-/usr/bin/systemctl start --no-block kubelab-notify-recovered@%n.service
# The device may already be gone.
ExecStop=-/usr/sbin/tc qdisc del dev {{ gateway_uplink_interface }} root
ExecStop=-/usr/sbin/tc qdisc del dev {{ gateway_uplink_interface }} ingress
ExecStop=-/usr/sbin/ip link del {{ gateway_uplink_ifb }}

# {{ ansible_managed }}
# Checks the lab Wi-Fi and the uplink, and brings a halted radio back (NET-005
# AC13): a driver reload first, then one reboot per outage, and a cap on reboots per
# hour for a radio that flaps. A failing component pages once per incident, and the
# next clean run closes it (node_notify).
[Unit]
Description=Check the lab Wi-Fi and the uplink, and recover a halted radio
OnFailure=kubelab-notify@%n.service
OnSuccess=kubelab-notify-recovered@%n.service

[Service]
Type=oneshot
# An edge that holds after its own reboot needs its power cable pulled, so it
# pages rather than logs (#2684). node_notify reads this from systemd when the
# unit fails.
Environment=KUBELAB_NOTIFY_SEVERITY=page
Environment=EDGE_LIVENESS_GRACE={{ gateway_liveness_grace }}
Environment=EDGE_LIVENESS_MAX_REBOOTS={{ gateway_liveness_max_reboots }}
# A oneshot has no start timeout by default, and a wedged driver can hang the
# unload in the kernel: without one the unit never ends and the timer never fires
# again. The script's own bounds (two 30 s modprobes, 30 s for the interface,
# hostapd's stop) fit inside it.
TimeoutStartSec=5min
ExecStart={{ gateway_liveness_path }} {{ gateway_ap_interface }} {{ gateway_ap_driver }} {{ gateway_uplink_interface }}
# The misses and the reload marker live in /run, so a reboot starts the ladder
# again. The reboots are counted in /var/lib, so a reboot cannot reset the cap.
RuntimeDirectory=kubelab-edge-liveness
RuntimeDirectoryPreserve=yes
StateDirectory=kubelab-edge-liveness
# No PrivateTmp and no read-only /tmp: hostapd_cli binds its reply socket under
# /tmp, and hostapd answers to that path in its own mount namespace.
NoNewPrivileges=yes
ProtectHome=yes

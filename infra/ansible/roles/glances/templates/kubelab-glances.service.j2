# {{ ansible_managed }}
# Brings the node's Glances container up once its Tailscale address exists.
#
# WHY THIS UNIT EXISTS
# --------------------
# Glances publishes on {{ tailscale_ip }}:{{ glances_port }} rather than 0.0.0.0,
# because a published port is governed by its bind address and nothing else —
# Docker's DNAT runs before ufw's filter chains, so an interface-scoped firewall
# rule on a published port is decoration (#959).
#
# The cost of that correct choice is a boot race. Docker starts before tailscaled
# has put the address on the interface, docker-proxy cannot bind, and the
# container comes up WITHOUT its port published — measured 2026-08-15 on beelink
# and ace1, where HostConfig.PortBindings asked for the Tailscale address while
# NetworkSettings.Ports was empty. Nothing reports it: `docker ps` shows the
# container Up, and `docker compose up -d` sees an unchanged spec hash and does
# nothing. Five of seven Glances endpoints were unreachable from the dashboard
# that scrapes them, silently, since the previous boot.
#
# `restart: unless-stopped` on the container cannot fix this. The port binding is
# fixed at container *create* time, so a restart re-runs the same unbound
# container; only a recreate re-publishes. Ordering the create after the address
# exists is what removes the race rather than papering over it.
[Unit]
Description=KubeLab Glances (published on the node's Tailscale address)
Documentation=https://github.com/mlorentedev/kubelab
Requires=docker.service
After=docker.service tailscaled.service network-online.target
Wants=network-online.target tailscaled.service

[Service]
# exec, not oneshot (#2776). A oneshot waits inside its start job, and systemd
# records the boot as finished only once no job is left: with the tailnet
# unreachable the wait below fails and is retried every 30 s, so the boot of a
# site with no uplink never finished. An exec unit's job ends once its command
# runs. The provision waits for the stack instead (stack-unit-settled.yml).
Type=exec
RemainAfterExit=yes
# Bounds the wait and compose together, as TimeoutStartSec did for the oneshot,
# and comfortably above the wait's own bound so its explicit failure is what
# surfaces. The bound stops once the command has exited and the unit is `exited`.
RuntimeMaxSec=180
# The wait below is bounded, and nothing runs a unit again once it failed at
# boot. An address that arrives later, because the tailnet is unreachable until
# the lab edge's uplink is up, left every stack bound to it unbound for a day on
# 2026-10-26 (#2500). So retry: 30 s keeps a wait that fails fast clear of
# systemd's default start limit (5 starts in 10 s), which would end the retries.
# Only the wait is retried: compose exits 1 on an error of its own (a port held,
# a broken mount), and retrying that would recreate the whole stack every 30 s
# and never reach `failed`, where node_notify's OnFailure sees it. The wait
# fails with 75 instead, below, so it still retries.
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=1
# --force-recreate, not a plain `up -d`: if a previous boot left an unbound
# container behind, the spec hash still matches and compose would leave it alone.
# --pull never: the provision pulls before it starts this unit. A pull here
# is cut at RuntimeMaxSec on a slow link, a timeout restarts the unit, and
# each retry pulls again, so the stack never starts and never reaches
# `failed`. A missing image instead exits 1, which fails the unit.
ExecStart=/bin/sh -c '{{ glances_deploy_dir }}/wait-for-tailscale-addr.sh {{ tailscale_ip }} || exit 75; exec /usr/bin/docker compose -f {{ glances_deploy_dir }}/compose.yml up -d --force-recreate --pull never'
ExecStop=/usr/bin/docker compose -f {{ glances_deploy_dir }}/compose.yml stop

[Install]
WantedBy=multi-user.target

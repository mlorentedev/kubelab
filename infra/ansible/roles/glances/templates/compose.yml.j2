# {{ ansible_managed }}
# Shared Glances stack — bound to Tailscale IP (DASH-DT-014a)
services:
  glances:
    image: {{ glances_image }}
    container_name: glances
    restart: {{ restart_policy }}
    ports:
      - "{{ tailscale_ip }}:{{ glances_port }}:{{ glances_port }}"
    environment:
      - GLANCES_OPT={{ glances_opts }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /etc/os-release:/etc/os-release:ro
      # Host-header allowlist (DNS-rebinding protection). No `-C` in
      # GLANCES_OPT: /etc/glances/glances.conf is already the first path
      # Glances finds, and it is the file the image ships there -- mounting
      # over it is what makes ours win. See templates/glances.conf.j2.
      - {{ glances_deploy_dir }}/glances.conf:/etc/glances/glances.conf:ro
    deploy:
      resources:
        limits:
          cpus: "{{ glances_cpu_limit }}"
          memory: "{{ glances_memory_limit }}"
    pid: host

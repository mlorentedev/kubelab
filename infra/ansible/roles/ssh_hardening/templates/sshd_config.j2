# Managed by Ansible — do not edit manually
# Source: infra/ansible/roles/ssh_hardening/templates/sshd_config.j2

Port {{ ssh_port }}
AddressFamily any
ListenAddress 0.0.0.0

# Authentication
PermitRootLogin {{ ssh_permit_root_login }}
PubkeyAuthentication {{ ssh_pubkey_authentication }}
PasswordAuthentication {{ ssh_password_authentication }}
ChallengeResponseAuthentication no
MaxAuthTries {{ ssh_max_auth_tries }}

# Session
ClientAliveInterval {{ ssh_client_alive_interval }}
ClientAliveCountMax {{ ssh_client_alive_count_max }}
LoginGraceTime 30

# Security
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
PermitTunnel no
PermitUserEnvironment no
# Skip reverse-DNS lookup on connect — avoids SSH hangs on cloud nodes
# whose PTR records lag behind their public IP rotation (Spot reclaim).
UseDNS no
GSSAPIAuthentication no

# Logging
SyslogFacility AUTH
LogLevel INFO

# Subsystems
Subsystem sftp /usr/lib/openssh/sftp-server

# Accept locale-related environment variables
AcceptEnv LANG LC_*

# Use PAM
UsePAM yes
{% if ssh_lan_jump_targets | length > 0 %}

# LAN jump host: the operator's `*-lan` SSH aliases reach the inner-LAN nodes
# through this node (ProxyJump), which needs a TCP forward. Only the SSH port of
# the declared nodes is open to it; agent forwarding stays off. Match blocks
# apply to the end of the file, so this one must stay last.
Match User {{ ansible_user }}
    AllowTcpForwarding yes
    PermitOpen {% for target in ssh_lan_jump_targets %}{{ target }}:{{ ssh_port }}{{ ' ' if not loop.last else '\n' }}{% endfor %}
{% endif %}

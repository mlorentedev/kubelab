# {{ ansible_managed }}
# Brings the RPi3's Compose stack up once the node's Tailscale address exists.
#
# Ported from beelink_services/kubelab-compose.service.j2, which documents the
# failure this prevents: at boot, Docker races tailscaled, the bind to the
# Tailscale address fails, and the container never publishes its ports at all.
# `restart: unless-stopped` does not cover it — the container IS running, so a
# restart policy has nothing to restart. It just serves nothing.
#
# Why this node needed it most, and got it last. The RPi3 is always-on, so its
# reboots are rare — which is exactly why the gap survived: a race you lose once
# a year is a race nobody sees. And what it hosts is Uptime Kuma, the monitoring
# of record (ADR-028). A silent bind failure here does not take down a service;
# it takes down the thing that would have told you a service was down. Every
# other monitor stays green because nothing is asking them.
#
# Measured precedent on rpi4, 2026-08-22: CoreDNS lost its ENTIRE port
# publication to this race after a reboot, staging DNS was dead for ~90 minutes,
# and three green signals covered it. rpi4 was fixed by binding to its LAN
# address instead; the RPi3 is not on 172.16.1.0/24, so ordering is the only
# remedy available here.
[Unit]
Description=KubeLab RPi3 Compose stack (Uptime Kuma)
Documentation=https://github.com/mlorentedev/kubelab
Requires=docker.service
After=docker.service tailscaled.service network-online.target
Wants=network-online.target tailscaled.service

[Service]
# exec, not oneshot (#2776). A oneshot waits inside its start job, and systemd
# records the boot as finished only once no job is left: with the tailnet
# unreachable the wait below fails and is retried every 30 s, so the boot of a
# site with no uplink never finished. An exec unit's job ends once its command
# runs. The provision waits for the stack instead (stack-unit-settled.yml).
Type=exec
RemainAfterExit=yes
# Bounds the wait and compose together, as TimeoutStartSec did for the oneshot,
# and comfortably above the wait's own bound so its explicit failure is what
# surfaces. The bound stops once the command has exited and the unit is `exited`.
RuntimeMaxSec=180
# The wait below is bounded, and nothing runs a unit again once it failed at
# boot. An address that arrives later, because the tailnet is unreachable until
# the lab edge's uplink is up, left every stack bound to it unbound for a day on
# 2026-10-26 (#2500). So retry: 30 s keeps a wait that fails fast clear of
# systemd's default start limit (5 starts in 10 s), which would end the retries.
# Only the wait is retried: compose exits 1 on an error of its own (a port held,
# a broken mount), and retrying that would recreate the whole stack every 30 s
# and never reach `failed`, where node_notify's OnFailure sees it. The wait
# fails with 75 instead, below, so it still retries.
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=1
# --force-recreate: dockerd resurrects Uptime Kuma at boot through
# `restart: unless-stopped`, before this unit and before the address exists, and
# plain `up -d` adopts that container as it is, bound to nothing (#2500). The
# beelink unit records how that was measured (ANSIBLE-053).
# --pull never: the provision pulls before it starts this unit. A pull here
# is cut at RuntimeMaxSec on a slow link, a timeout restarts the unit, and
# each retry pulls again, so the stack never starts and never reaches
# `failed`. A missing image instead exits 1, which fails the unit.
ExecStart=/bin/sh -c '{{ rpi3_deploy_dir }}/wait-for-tailscale-addr.sh {{ tailscale_ip }} || exit 75; exec /usr/bin/docker compose -f {{ rpi3_deploy_dir }}/compose.yml up -d --force-recreate --pull never'
ExecStop=/usr/bin/docker compose -f {{ rpi3_deploy_dir }}/compose.yml stop

[Install]
WantedBy=multi-user.target

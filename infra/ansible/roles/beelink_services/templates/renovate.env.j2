# {{ ansible_managed }}
#
# Environment for the Gitea Renovate run (IDP-036), read by its systemd unit with
# EnvironmentFile= (AC2). RENOVATE_IMAGE is ci-workflows' renovate/engine.json at
# the tag the global config extends, resolved when the node was provisioned
# (AC4): kubelab carries no engine version of its own.
RENOVATE_IMAGE={{ renovate_engine.image }}:{{ renovate_engine.version }}

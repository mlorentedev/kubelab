# {{ ansible_managed }}
#
# Environment for the Gitea Renovate run (IDP-036), read two ways: by its systemd
# unit with EnvironmentFile= (RENOVATE_IMAGE, which the wrapper runs) and by the
# container with --env-file (everything else). Every line is a value Renovate
# reads from its environment, and none is repeated in config.yaml: the two are
# merged, and an option declared in both is a question of which wins.
#
# RENOVATE_IMAGE is ci-workflows' renovate/engine.json at the tag the global
# config extends, resolved when the node was provisioned (AC4): kubelab carries no
# engine version of its own. Renovate ignores it as an option of its own.
RENOVATE_IMAGE={{ renovate_engine.image }}:{{ renovate_engine.version }}
RENOVATE_PLATFORM=gitea
# The forge by its container name on the compose network `kubelab`, which the run
# joins like act_runner does (GITEA_INSTANCE_URL in compose.yml.j2): no DNS, TLS
# or tailnet in the path.
RENOVATE_ENDPOINT=http://gitea:3000/api/v1
RENOVATE_CONFIG_FILE={{ renovate_config_container_path }}
# The machine account's token (AC6), recorded in SOPS at
# apps.services.core.gitea.renovate_token. Empty until the provision that mints it
# has run, and the run is not enabled until it is. The read-only GITHUB_COM_TOKEN
# the `github>` preset fetch needs is not here yet: it is the next change's, and
# its gate joins `renovate_enabled` with it.
RENOVATE_TOKEN={{ gitea_renovate_token }}

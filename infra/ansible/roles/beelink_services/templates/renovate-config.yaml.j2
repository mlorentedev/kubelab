# {{ ansible_managed }}
#
# Global config for the Gitea Renovate run (IDP-036). Renovate reads it through
# RENOVATE_CONFIG_FILE.
#
# The fleet defaults come from the shared preset in mlorentedev/ci-workflows, at
# the tag declared in ci.renovate.preset_tag (AC3); no Gitea repository holds a
# copy. `onboarding: false` with `requireConfig: optional` processes a repository
# whether or not it carries a renovate.json, so a new repository needs no commit.
extends:
  - "github>mlorentedev/ci-workflows//renovate/default#{{ renovate_preset_tag }}"
onboarding: false
requireConfig: optional

# `repositories` is rendered from apps.services.core.gitea.organizations, the same
# declaration the repository reconciler creates them from, so a repository
# declared there is covered here without another edit (AC1). Organizations are
# sorted so a re-render is byte-identical and the provision stays at changed=0.
# An organization declared with no repositories contributes nothing, and an
# empty declaration renders `[]`, never a null Renovate would read as unset.
{% set _repositories = [] %}
{% for org in renovate_gitea_organizations | dictsort | map('first') %}
{%   for repo in ((renovate_gitea_organizations[org] or {}).get('repositories') or []) %}
{%     set _ = _repositories.append(org ~ '/' ~ repo.name) %}
{%   endfor %}
{% endfor %}
repositories: {{ _repositories | to_json }}

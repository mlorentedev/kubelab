# {{ ansible_managed }}
# Beelink Platform Services — Gitea + MinIO + GitHub Actions Runner + Glances (ADR-028)
# This file contains rendered secrets — mode 0600, owned by root.
services:
  # Gitea — the platform's git singleton (ADR-061: state_promotion=singleton,
  # location=on-demand). It runs in Docker Compose rather than K3s for the same
  # structural reason Headscale does (ADR-015): a component Argo CD would need to
  # fetch from cannot be reconciled by Argo CD. Argo CD reconciles from GitHub.
  #
  # The environment identity is PROD even though this node is provisioned with
  # deploy_env=staging — ADR-061's axes are independent, and "prod is an
  # environment, not a location". See provision-bee.yml's gitea_secrets_env.
  gitea:
    image: {{ gitea_image }}
    container_name: gitea
    restart: {{ restart_policy }}
    ports:
      # Bound to the Tailscale IP, never 0.0.0.0. A published port is governed by
      # its bind address and nothing else: Docker's DNAT is evaluated before ufw's
      # filter chains and DOCKER-USER is empty on every node in this fleet, so an
      # interface-scoped ufw rule on a published port is decoration.
      - "{{ tailscale_ip }}:{{ gitea_http_port }}:3000"
      # Container port 22, not {{ gitea_ssh_port }}: the official image runs OpenSSH
      # there, and Gitea's own built-in SSH server is opt-in via START_SSH_SERVER.
      # The K8s manifest this replaces set SSH_LISTEN_PORT=2222 without enabling
      # that server, so nothing was listening on the port it published — one of the
      # reasons its advertised clone URL had never connected.
      - "{{ tailscale_ip }}:{{ gitea_ssh_port }}:22"
    environment:
      GITEA__database__DB_TYPE: "sqlite3"
      GITEA__server__DOMAIN: "{{ gitea_domain }}"
      GITEA__server__ROOT_URL: "https://{{ gitea_domain }}/"
      # HTTP arrives through K3s Traefik at {{ gitea_domain }}; SSH cannot, because
      # SSH is not HTTP. The advertised clone URL therefore points at the node's
      # MagicDNS name directly, and is reachable from the tailnet only.
      GITEA__server__SSH_DOMAIN: "{{ gitea_ssh_host }}"
      # Advertised in clone URLs only — the published host port above. Deliberately
      # no SSH_LISTEN_PORT: that configures the built-in server, which is off.
      GITEA__server__SSH_PORT: "{{ gitea_ssh_port }}"
      GITEA__service__DISABLE_REGISTRATION: "true"
      # SEC-GITEA-001 (#1389). Gitea's default is `false`, and `gitea.kubelab.live`
      # has a public Cloudflare A record whose IngressRoute carries no network
      # restriction — so without this, everything a repository marks public is
      # world-readable, and `/explore/users` enumerates accounts anonymously.
      # Measured 2026-08-24 before this line: /api/swagger 200, /api/v1/version
      # 200 ({"version":"1.25.5"}), /explore/repos 200, /explore/users 200.
      #
      # Nothing leaked, for one reason only: the forge was empty. That is safety
      # by absence of content, not by configuration, and TOOL-035 (#1076) is the
      # step that ends it. Set BEFORE the first repository, deliberately.
      #
      # Does NOT close the paths the migration needs: git-over-HTTP authenticates
      # separately, and the login page stays reachable so the OIDC flow works.
      GITEA__service__REQUIRE_SIGNIN_VIEW: "true"
      # REQUIRE_SIGNIN_VIEW does NOT cover the Swagger UI — measured 2026-08-24,
      # /api/swagger still returned 200 with signin required, because the page is
      # served as a static asset rather than through the gated API router. This
      # was filed as an optional third step and the measurement made it required.
      GITEA__api__ENABLE_SWAGGER: "false"
      GITEA__openid__ENABLE_OPENID_SIGNIN: "false"
      GITEA__openid__ENABLE_OPENID_SIGNUP: "false"
      GITEA__log__MODE: "console"
      GITEA__log__LEVEL: "Info"
      GITEA__security__SECRET_KEY: "{{ gitea_secret_key }}"
      GITEA__security__INSTALL_LOCK: "true"
      # Consumed by gitea-bootstrap.sh, not by Gitea itself.
      GITEA_HEALTH_PATH: "{{ gitea_health_path }}"
      GITEA_ADMIN_USER: "{{ gitea_admin_user }}"
      GITEA_ADMIN_PASSWORD: "{{ gitea_admin_password }}"
      GITEA_ADMIN_EMAIL: "{{ gitea_admin_email }}"
      GITEA_OIDC_CLIENT_SECRET: "{{ gitea_oidc_client_secret }}"
      GITEA_OIDC_DISCOVERY_URL: "{{ gitea_oidc_discovery_url }}"
      # AUTH-004 C5. The machine identity's NAME, resolved from
      # apps.auth.identities.machine — never a literal, which is the alias shape
      # that renamed Gitea's only admin on 2026-08-23. Consumed by
      # gitea-bootstrap.sh, not by Gitea itself.
      GITEA_BOT_USER: "{{ gitea_bot_user }}"
      GITEA_BOT_EMAIL: "{{ gitea_bot_email }}"
    volumes:
      - {{ beelink_gitea_data_dir }}:/data
      - {{ beelink_deploy_dir }}/gitea-bootstrap.sh:/scripts/bootstrap.sh:ro
    healthcheck:
      # `health_path` from common.yaml, not a hardcoded path. It was declared
      # there and read by nothing while this line named /api/v1/version — a
      # divergence that was invisible until SEC-GITEA-001 closed the API and
      # the container went unhealthy. /api/healthz is exempt from
      # REQUIRE_SIGNIN_VIEW (measured 2026-08-24: 200 with signin required,
      # against 403 for /api/v1/version).
      test: ["CMD", "wget", "-qO-", "http://localhost:3000{{ gitea_health_path }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits:
          cpus: "{{ gitea_cpu_limit }}"
          memory: "{{ gitea_memory_limit }}"
    networks:
      - kubelab

  minio:
    image: {{ minio_image }}
    container_name: minio
    command: server /data --console-address ":{{ minio_console_port }}"
    restart: {{ restart_policy }}
    ports:
      - "{{ tailscale_ip }}:{{ minio_api_port }}:{{ minio_api_port }}"
      - "{{ tailscale_ip }}:{{ minio_console_port }}:{{ minio_console_port }}"
    environment:
      MINIO_ROOT_USER: "{{ minio_root_user }}"
      MINIO_ROOT_PASSWORD: "{{ minio_root_password }}"
    volumes:
      - {{ beelink_minio_data_dir }}:/data
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ minio_api_port }}/minio/health/live"]
      interval: 10s
      timeout: 5s
      retries: 3
    deploy:
      resources:
        limits:
          cpus: "{{ minio_cpu_limit }}"
          memory: "{{ minio_memory_limit }}"
    networks:
      - kubelab

  github-runner:
    image: {{ runner_image }}
    container_name: github-runner
    restart: {{ restart_policy }}
    environment:
      REPO_URL: "{{ runner_repo_url }}"
      RUNNER_NAME: "kubelab-bee"
      ACCESS_TOKEN: "{{ runner_access_token }}"
      RUNNER_WORKDIR: /tmp/runner
      RUNNER_GROUP: "{{ runner_group }}"
      LABELS: "{{ runner_labels }}"
      EPHEMERAL: "1"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - runner_data:/tmp/runner
      - runner_toolcache:/opt/hostedtoolcache
    deploy:
      resources:
        limits:
          cpus: "{{ runner_cpu_limit }}"
          memory: "{{ runner_memory_limit }}"
    networks:
      - kubelab

# Glances extracted to the shared `roles/glances/` role (DASH-DT-014b).
# Invoked from provision-bee.yml separately so this role only owns MinIO
# and the GitHub Actions Runner.

volumes:
  runner_data:
    name: github_runner_data
  runner_toolcache:
    name: github_runner_toolcache

networks:
  kubelab:
    name: kubelab
    external: true

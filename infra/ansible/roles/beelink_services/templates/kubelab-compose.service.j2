# {{ ansible_managed }}
# Brings the Beelink's Compose stack up once the node's Tailscale address exists.
#
# The containers already carry `restart: unless-stopped`, which covers a service
# that crashes while running. It does NOT cover this node's actual failure mode:
# at boot, Docker races tailscaled, the bind to the Tailscale address fails, and
# the container never starts at all — a restart policy has nothing to restart.
#
# This matters more here than it would anywhere else in the fleet. The Beelink is
# classified `location: on-demand` (ADR-028 / ADR-061), which means powering it on
# IS its normal operation, not an exceptional event. A stack that only survives an
# uninterrupted uptime is not on-demand in any useful sense.
[Unit]
Description=KubeLab Compose stack (Gitea, MinIO, GitHub runner)
Documentation=https://github.com/mlorentedev/kubelab
Requires=docker.service
After=docker.service tailscaled.service network-online.target
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Comfortably above the wait script's own bound, so its explicit failure is what
# surfaces rather than an opaque systemd timeout.
TimeoutStartSec=180
ExecStartPre={{ beelink_deploy_dir }}/wait-for-tailscale-addr.sh {{ tailscale_ip }}
# `--force-recreate` is the whole fix for ANSIBLE-053, and it is not defensive.
#
# The wait script above is necessary and NOT sufficient. Measured 2026-08-23: on
# a cold boot it reported `100.64.0.3 is up on tailscale0 after 20s`, the unit
# then ran, reported success — and gitea and minio came up attached to NO network,
# publishing nothing, `healthy` for over an hour. Their only traffic was their own
# healthcheck from [::1]. github-runner, the one service in this stack that
# declares no `ports:`, was unaffected.
#
# Plain `up -d` cannot repair that state, and this is measured rather than
# reasoned: the broken state was reproduced deterministically with
# `docker network disconnect kubelab gitea`, and `systemctl restart` on this unit
# left it exactly as it was — HTTP 000 before and after. compose sees a container
# whose spec hash is unchanged and starts it as-is; the network attachment is not
# part of that hash.
#
# Why recreate rather than `ExecStop=... down`, which would also leave nothing
# stale to start: `down` only runs on a GRACEFUL shutdown. BACKUP-044's Part 0
# measured the path that matters here — on a power cut ExecStop never runs at all,
# and dockerd resurrects the containers at +10s via `restart: unless-stopped`,
# before tailscaled and before this unit. A fix that lives in ExecStop is absent
# in exactly the scenario an on-demand node exists to survive. This one runs after
# the guard on every boot, however that boot began and whatever dockerd already
# resurrected.
#
# Cost: a few seconds per boot, and pre-boot `docker logs` are lost — persistent
# journald (ANSIBLE-023) already covers that. Service data is in bind mounts and
# is untouched by a recreate.
ExecStart=/usr/bin/docker compose -f {{ beelink_deploy_dir }}/compose.yml up -d --force-recreate
ExecStop=/usr/bin/docker compose -f {{ beelink_deploy_dir }}/compose.yml stop

[Install]
WantedBy=multi-user.target

#!/bin/bash
# {{ ansible_managed }}
# Fleet failure notification (NOTIFY-001). Fires from any unit that declares
#
#     OnFailure=kubelab-notify@%n.service
#
# and receives the failed unit's name as $1 (the template unit passes `%i`).
# Posts a `{{ node_notify_severity }}`-severity envelope to n8n's public
# /webhook/notify ingress -- n8n routes by severity and forwards to Apprise
# internally.
#
# Extracted from kubelab-maintenance-notify.sh (ANSIBLE-035) when BACKUP-044
# Part 5 needed the same five ANSIBLE-038 hardenings for the backup units.
# They are preserved verbatim below, with their measurements, because each one
# was paid for once and a re-derivation is where they get lost.
#
# Always prod n8n, regardless of this node's own deploy_env: alerting must not
# depend on ace1 (staging n8n's host) being powered on. The token is prod
# n8n's Header Auth credential, resolved from
# apps.services.automation.notify.fleet_webhook_secret (a dedicated key,
# immune to the staging-env override that apps.services.automation.notify.
# webhook_secret carries on this node's own env).
set -euo pipefail

# The unit is systemd-supplied via `%i`, but this script is also runnable by
# hand and its argument reaches `journalctl -u`. Constrained to the character
# set a systemd unit name can actually contain, so a hand invocation cannot
# turn it into an option or a second argument.
UNIT="${1:?usage: $(basename "$0") <failed-unit-name>}"
case "$UNIT" in
  -*|*[!A-Za-z0-9@:.\\_-]*)
    echo "refusing to notify for an implausible unit name: $UNIT" >&2
    exit 64 ;;
esac

TOKEN="$(cat {{ node_notify_secret_file }})"

# Trim to keep the envelope body small; n8n/Apprise render it as-is.
BODY_TAIL="$(journalctl -u "$UNIT" -n {{ node_notify_journal_lines }} --no-pager 2>/dev/null \
  | tail -c {{ node_notify_body_bytes }})"

# The unit's ACTUAL last result, so the title can state what is true rather than
# assume that this script running means something failed.
#
# It does not. `OnFailure=` is one caller; `systemctl start kubelab-notify@X` by
# hand is another, and that is exactly what the delivery test does. Before this,
# the test posted "X failed on <node>" with a body showing X's last run --
# which, the test being run on a healthy fleet, was a SUCCESS. Measured
# 2026-08-21: an envelope titled "node-backup-ship.service failed on rpi3"
# carrying `ship complete` and `Deactivated successfully` reached the operator's
# phone at 08:00. A channel that cries failure over a healthy backup teaches
# people to skim it, which is the exact indifference this whole path exists to
# prevent.
#
# `| cut` rather than `--value`, which is systemd >= 230: this fleet is well
# past that, but the parse costs nothing and the script also runs on the Jetson
# class of node. `|| true` because `set -e` is active and an unknown unit is a
# legitimate state here -- it yields an empty result and the neutral wording.
UNIT_RESULT="$(systemctl show -p Result "$UNIT" 2>/dev/null | cut -d= -f2 || true)"

# JSON-encode via python3 (present on every node Ansible manages) rather than
# shell string interpolation -- journal content can contain quotes, newlines,
# and other characters that would break a hand-built JSON string.
#
# ANSIBLE-038: read stdin as BYTES and decode with errors='replace' rather
# than sys.stdin.read(). `tail -c` above cuts on a byte boundary, so a
# multi-byte UTF-8 character straddling it reaches python as a truncated
# sequence and sys.stdin.read() raises UnicodeDecodeError -- which fails this
# unit and loses the very notification it exists to deliver. Measured:
# `printf 'caf\xc3' | python3 -c "...sys.stdin.read()..."` ->
# "can't decode byte 0xc3 in position 3: unexpected end of data".
#
# $UNIT reaches python through the ENVIRONMENT, never interpolated into the
# program text. Extracting this script made the unit name a runtime value for
# the first time, and a runtime value spliced into source is an injection
# vector -- json.dumps would have escaped it for the payload, but only after
# python had already parsed it as code.
PAYLOAD="$(printf '%s' "$BODY_TAIL" | FAILED_UNIT="$UNIT" UNIT_RESULT="$UNIT_RESULT" python3 -c "
import json, os, sys
unit = os.environ['FAILED_UNIT']
raw = os.environ.get('UNIT_RESULT', '')
# An empty result means systemd does not know the unit, which is not a failure
# either -- so anything but a positive failure signal takes the neutral wording.
failed = bool(raw) and raw != 'success'
shown = raw or 'unknown'
# Resolved BEFORE the f-string. A quoted fallback inside the replacement field
# needs a backslash to survive the surrounding shell double-quotes, and a
# backslash inside an f-string expression is a syntax error on any Python
# before 3.12 -- which this fleet does not uniformly have.
print(json.dumps({
    'domain': 'fleet',
    'severity': '{{ node_notify_severity }}',
    'title': (
        f'{unit} failed on {{ inventory_hostname }}'
        if failed
        # No alarming word anywhere in this branch, deliberately: a phone shows
        # the title and little else, and 'not in a failed state' still reads as
        # 'failed' at a glance. State the result instead of negating a claim.
        else f'notify path exercised on {{ inventory_hostname }} -- {unit} last result: {shown}'
    ),
    'body': sys.stdin.buffer.read().decode('utf-8', 'replace'),
    'source': '{{ inventory_hostname }}/kubelab-notify',
}))
")"

# ANSIBLE-038 f4: the token goes to curl through a config on STDIN, never as
# an argv element. As `-H "Authorization: Bearer ${TOKEN}"` it was readable in
# `ps` / /proc/<pid>/cmdline for the ~1s of the call. Low practical risk (root
# oneshot, short window) but fleet_webhook_secret is fleet-wide and rotates
# only by re-provisioning every node, so its blast radius is wide.
#
# Note this is a DIFFERENT mechanism from the shell-injection finding that was
# refuted in #1088: expanding a variable inside double quotes does not
# re-parse its value, and that still holds. Whether the value is re-parsed and
# where the value ends up are separate questions; only the second one bites.
#
# The escaping below is load-bearing, not defensive dressing. curl's config
# parser processes \ and " inside a quoted value, so an unescaped token is
# silently CORRUPTED rather than rejected -- measured against a local listener:
# a token containing `"` arrived as `Bearer tok`, and the unquoted config form
# dropped the header entirely. Either way n8n answers 403 and the failure
# notification is lost, which is strictly worse than the exposure being fixed.
TOKEN_ESC=${TOKEN//\\/\\\\}
TOKEN_ESC=${TOKEN_ESC//\"/\\\"}

# -f: a 4xx/5xx from n8n makes curl (and this script, under set -o pipefail)
# exit non-zero, so a delivery failure is visible as THIS unit failing --
# `systemctl status kubelab-notify@<unit>.service` / its journal -- rather
# than silently swallowed.
#
# ANSIBLE-038 f1: bounded timeouts. Without them curl uses its defaults and an
# unreachable n8n stalls this unit until systemd kills it.
#
# 5/10 rather than the 10/15 #1088 suggested, and the tighter pair is the point
# rather than a drift: the finding's own words are "a 30s stall on a path whose
# entire job is to report promptly". A single attempt is not the reliability
# budget here -- there are four of them (--retry 3), so a genuinely slow n8n is
# covered by retrying rather than by waiting longer on the first try, and the
# operator learns sooner when it is unreachable. Both pairs fit under
# TimeoutStartSec=45 (30s worst case here, 35s at 10/15), so this is a choice
# within the budget, not a constraint imposed by it. Settled when #1088 closed;
# recorded here because a reviewer re-raised it, correctly, from a comment that
# explained the retry arithmetic and not this.
#
# ANSIBLE-038 f5: the retry lives HERE rather than as Restart= on the unit.
# systemd would re-run the whole script (re-reading the journal, re-encoding)
# and its start-limit interacts badly with RestartSec; curl retries the request
# alone. --retry covers exactly the transient cases that motivated the finding:
# connection refused (--retry-connrefused), timeouts, and 5xx -- verified
# against a listener returning 503 twice, which curl rode out and delivered.
#
# The budget is chosen so the worst case fits inside TimeoutStartSec. Measured
# against a blackholed address (RFC 5737 TEST-NET-3, packets dropped rather
# than refused, which is the slow case): without --retry-max-time the same
# retry count took 35.0s and systemd's 30s timeout would have killed the unit
# mid-flight -- i.e. adding a retry naively would have turned a clean failure
# into a truncated one. --retry-max-time 20 stops curl starting a NEW attempt
# after 20s, so worst case is 20s + one final --max-time 10 attempt = 30s,
# under the unit's TimeoutStartSec=45.
printf 'header = "Authorization: Bearer %s"\n' "$TOKEN_ESC" | curl -sS -f --config - \
  --connect-timeout 5 --max-time 10 \
  --retry 3 --retry-delay 5 --retry-connrefused --retry-max-time 20 \
  -X POST "https://{{ node_notify_domain }}/webhook/notify" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD" \
  -o /dev/null

# {{ ansible_managed }}
# hermes-kubelab on ace2 (ADR-068 D2, spec AI-009-hermes-ace2).
#
# On the AGENT's rootless daemon, never the system one: the socket mounted below
# is root inside the agent's user namespace only, so the sandboxes the gateway
# starts through it are too.
services:
  hermes:
    image: {{ agent_stack_hermes.image }}
    container_name: hermes-kubelab
    restart: unless-stopped
    command: ["gateway", "run"]
    env_file:
      - {{ agent_stack_hermes_env }}
    environment:
      HERMES_HOME: {{ agent_stack_hermes_home }}
    # The image is its own init (s6-overlay must be PID 1), so no `init: true`.
    volumes:
      # The same path on both sides. The gateway computes the host side of every
      # sandbox mount from its own view of HERMES_HOME, and the daemon resolves
      # that path on the host, so a different path inside would mount nothing.
      - {{ agent_stack_hermes_home }}:{{ agent_stack_hermes_home }}
      # Read-only over the image's own copy, which it would hand to its runtime user.
      - {{ agent_stack_hermes_config }}:{{ agent_stack_hermes_home }}/config.yaml:ro
      # Where the image looks for a socket to join the group of.
      - /run/user/{{ _agent_stack_agent_uid }}/docker.sock:/var/run/docker.sock
    # Loopback only: Open WebUI reaches it from the host, nothing else does.
    ports:
      - "127.0.0.1:{{ agent_stack_hermes.api_port }}:{{ agent_stack_hermes.api_port }}"
    mem_limit: {{ agent_stack_hermes.memory_limit }}
    cpus: {{ agent_stack_hermes.cpu_limit }}
    # Public resolvers only: the agent's user is refused the tailnet, MagicDNS included.
    dns:
{% for server in agent_stack_hermes_dns_servers %}
      - {{ server }}
{% endfor %}

  # The agent's tailnet identity (ADR-041): registered as `tag:hermes`, so the
  # ACL decides what it reaches, never ace2's allow-all. Userspace: no TUN and
  # no capability, and it routes nothing for the gateway. Only what a job sends
  # through its proxy reaches the tailnet, and the host refuses the rest.
  tailscale:
    image: {{ agent_stack_hermes.sidecar.image }}
    container_name: hermes-kubelab-tailscale
    restart: unless-stopped
    # The one-time preauth key, present only until the first registration.
    env_file:
      - {{ agent_stack_hermes_ts_env }}
    environment:
      TS_USERSPACE: "true"
      TS_HOSTNAME: {{ agent_stack_hermes.sidecar.hostname }}
      TS_STATE_DIR: /var/lib/tailscale
      # The CLI's own default, so `tailscale status` works without a flag.
      TS_SOCKET: /var/run/tailscale/tailscaled.sock
      # Log in only without a state: a restart never needs the consumed key.
      TS_AUTH_ONCE: "true"
      TS_ACCEPT_DNS: "false"
      # The tag comes from the key alone: `--advertise-tags` beside it fails
      # registration (ADR-041 errata).
      TS_EXTRA_ARGS: --login-server={{ agent_stack_headscale_url }}
      # On the project network only, no `ports:`: the gateway reaches it,
      # nothing outside the agent's daemon does.
      TS_SOCKS5_SERVER: ":{{ agent_stack_hermes.sidecar.proxy_port }}"
      TS_OUTBOUND_HTTP_PROXY_LISTEN: ":{{ agent_stack_hermes.sidecar.proxy_port }}"
    volumes:
      # Beside the data directory, not in it: the gateway does not see the node key.
      - {{ agent_stack_hermes_ts_state }}:/var/lib/tailscale
    mem_limit: {{ agent_stack_hermes.sidecar.memory_limit }}
    cpus: {{ agent_stack_hermes.sidecar.cpu_limit }}
    # Control and DERP are public names (vpn.kubelab.live resolves to the
    # VPS's public address), and MagicDNS is inside the refused range.
    dns:
{% for server in agent_stack_hermes_dns_servers %}
      - {{ server }}
{% endfor %}

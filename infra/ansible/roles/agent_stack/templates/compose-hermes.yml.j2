# {{ ansible_managed }}
# hermes-kubelab on ace2 (ADR-068 D2, spec AI-009-hermes-ace2).
#
# On the AGENT's rootless daemon, never the system one: the socket mounted below
# is root inside the agent's user namespace only, so the sandboxes the gateway
# starts through it are too.
services:
  hermes:
    image: {{ agent_stack_hermes.image }}
    container_name: hermes-kubelab
    restart: unless-stopped
    command: ["gateway", "run"]
    env_file:
      - {{ agent_stack_hermes_env }}
    environment:
      HERMES_HOME: {{ agent_stack_hermes_home }}
      # Where `write_file` may write (os.pathsep-separated; the image sets the data
      # directory alone). The sandbox mounts the zone writable and the rest of the
      # vault read-only, so the zone is the boundary already: naming it here makes the
      # tool agree with the mount instead of refusing a path the agent then writes
      # through the shell (#2321).
      HERMES_WRITE_SAFE_ROOT: "{{ agent_stack_hermes_home }}{% if agent_stack_vault_configured | bool %}:{{ agent_stack_hermes.vault_sync.mount }}/{{ agent_stack_vault_zone }}{% endif %}"
{% if agent_stack_vault_configured | bool %}
      # The zone's path, for the job scripts that read and write the curator's two
      # directories of it, which are mounted below (the judge input and the emitter).
      HERMES_VAULT_ZONE: "{{ agent_stack_hermes.vault_sync.mount }}/{{ agent_stack_vault_zone }}"
{% endif %}
    # The image is its own init (s6-overlay must be PID 1), so no `init: true`.
    volumes:
      # The same path on both sides. The gateway computes the host side of every
      # sandbox mount from its own view of HERMES_HOME, and the daemon resolves
      # that path on the host, so a different path inside would mount nothing.
      - {{ agent_stack_hermes_home }}:{{ agent_stack_hermes_home }}
      # Read-only over the image's own copy, which it would hand to its runtime user.
      - {{ agent_stack_hermes_config }}:{{ agent_stack_hermes_home }}/config.yaml:ro
      # The jobs' scripts, read-only for the same reason.
      - {{ agent_stack_hermes_scripts }}:{{ agent_stack_hermes_home }}/scripts:ro
      # The MCP servers the gateway starts, read-only for the same reason.
      - {{ agent_stack_hermes_mcp }}:{{ agent_stack_hermes_home }}/mcp:ro
      # Who the agent is: the role's persona and the operator's profile, never the agent's to edit.
      - {{ agent_stack_hermes_persona }}/SOUL.md:{{ agent_stack_hermes_home }}/SOUL.md:ro
{% if agent_stack_vault_configured | bool %}
      # The agent's memories are written where the user that syncs the zone can read
      # them: the data directory is 0700 for a subuid, which that user cannot open.
      - {{ agent_stack_vault_clone }}/{{ agent_stack_vault_zone }}/memories:{{ agent_stack_hermes_home }}/memories
{% endif %}
{% if agent_stack_vault_configured | bool %}
      # The curator's two directories, and nothing else of the zone (spec AI-012 6b): the
      # judge's input script reads the analyzer's candidates, and the emitter creates the
      # drafts. Read-only where it only reads; the rest of the zone stays the sandbox's.
      - {{ agent_stack_vault_clone }}/{{ agent_stack_vault_zone }}/curator:{{ agent_stack_hermes.vault_sync.mount }}/{{ agent_stack_vault_zone }}/curator:ro
      - {{ agent_stack_vault_clone }}/{{ agent_stack_vault_zone }}/proposals:{{ agent_stack_hermes.vault_sync.mount }}/{{ agent_stack_vault_zone }}/proposals
{% endif %}
{% if agent_stack_vault_configured | bool and agent_stack_hermes.skills | default([]) | length > 0 %}
      # The managed skills (spec AI-012 AC9): root-owned on the host and read-only here,
      # so the agent uses them through `skills.external_dirs` and cannot rewrite them.
      - {{ agent_stack_hermes_skills }}:{{ agent_stack_hermes_skills_mount }}:ro
{% endif %}
      # Where the image looks for a socket to join the group of.
      - /run/user/{{ _agent_stack_agent_uid }}/docker.sock:/var/run/docker.sock
    # On the host's address in Open WebUI's network, which ufw opens to that
    # network alone (spec AI-009 AC4); loopback when Open WebUI does not run.
    # rootlesskit listens in the host's namespace, so INPUT sees the traffic,
    # unlike the system daemon's DNAT.
    ports:
      - "{{ _agent_stack_hermes_bind }}:{{ agent_stack_hermes.api_port }}:{{ agent_stack_hermes.api_port }}"
    mem_limit: {{ agent_stack_hermes.memory_limit }}
    cpus: {{ agent_stack_hermes.cpu_limit }}
    # Public resolvers only: the agent's user is refused the tailnet, MagicDNS included.
    dns:
{% for server in agent_stack_hermes_dns_servers %}
      - {{ server }}
{% endfor %}

  # The agent's tailnet identity (ADR-041): registered as `tag:hermes`, so the
  # ACL decides what it reaches, never ace2's allow-all. Userspace: no TUN and
  # no capability, and it routes nothing for the gateway. Only what a job sends
  # through its proxy reaches the tailnet, and the host refuses the rest.
  tailscale:
    image: {{ agent_stack_hermes.sidecar.image }}
    container_name: hermes-kubelab-tailscale
    restart: unless-stopped
    # The one-time preauth key, present only until the first registration.
    env_file:
      - {{ agent_stack_hermes_ts_env }}
    environment:
      TS_USERSPACE: "true"
      TS_HOSTNAME: {{ agent_stack_hermes.sidecar.hostname }}
      TS_STATE_DIR: /var/lib/tailscale
      # The CLI's own default, so `tailscale status` works without a flag.
      TS_SOCKET: /var/run/tailscale/tailscaled.sock
      # Log in only without a state: a restart never needs the consumed key.
      TS_AUTH_ONCE: "true"
      TS_ACCEPT_DNS: "false"
      # The tag comes from the key alone: `--advertise-tags` beside it fails
      # registration (ADR-041 errata).
      TS_EXTRA_ARGS: --login-server={{ agent_stack_headscale_url }}
      # On the project network only, no `ports:`: the gateway reaches it,
      # nothing outside the agent's daemon does.
      TS_SOCKS5_SERVER: ":{{ agent_stack_hermes.sidecar.proxy_port }}"
      TS_OUTBOUND_HTTP_PROXY_LISTEN: ":{{ agent_stack_hermes.sidecar.proxy_port }}"
    volumes:
      # Beside the data directory, not in it: the gateway does not see the node key.
      - {{ agent_stack_hermes_ts_state }}:/var/lib/tailscale
    mem_limit: {{ agent_stack_hermes.sidecar.memory_limit }}
    cpus: {{ agent_stack_hermes.sidecar.cpu_limit }}
    # Control and DERP are public names (vpn.kubelab.live resolves to the
    # VPS's public address), and MagicDNS is inside the refused range.
    dns:
{% for server in agent_stack_hermes_dns_servers %}
      - {{ server }}
{% endfor %}

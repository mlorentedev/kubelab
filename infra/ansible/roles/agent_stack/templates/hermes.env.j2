# {{ ansible_managed }}
# hermes-kubelab's secrets (ADR-068 D3), 0600 and owned by the agent's user,
# read by Compose on the host and never mounted into the container.
# config.yaml names them by variable; only this file holds the values.
NAN_API_KEY={{ agent_stack_nan_api_key }}
# The OpenAI-compatible API refuses to start without a key, loopback included.
API_SERVER_ENABLED=true
API_SERVER_KEY={{ _agent_stack_hermes_api_key }}
# Inside the container: the published address in compose-hermes.yml decides who reaches it.
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT={{ agent_stack_hermes.api_port }}

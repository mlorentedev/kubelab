# {{ ansible_managed }}
# hermes-kubelab's secrets (ADR-068 D3), 0600 and owned by the agent's user,
# read by Compose on the host and never mounted into the container.
# config.yaml names them by variable; only this file holds the values.
NAN_API_KEY={{ agent_stack_nan_api_key }}
# The OpenAI-compatible API refuses to start without a key, loopback included.
API_SERVER_ENABLED=true
API_SERVER_KEY={{ _agent_stack_hermes_api_key }}
# Inside the container: the published address in compose-hermes.yml decides who reaches it.
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT={{ agent_stack_hermes.api_port }}
{% if agent_stack_slack_configured | bool %}
# The Slack gateway, Socket Mode (spec AI-009 PR 3c): the bot token acts, the
# app token connects. Only the listed members are obeyed, and only in the home
# channel or a 1:1 DM; the role starts no Slack without the list.
SLACK_BOT_TOKEN={{ agent_stack_slack_bot_token }}
SLACK_APP_TOKEN={{ agent_stack_slack_app_token }}
SLACK_ALLOWED_USERS={{ agent_stack_hermes.slack.allowed_users | join(',') }}
SLACK_ALLOWED_CHANNELS={{ agent_stack_hermes.slack.home_channel.id }}
SLACK_HOME_CHANNEL={{ agent_stack_hermes.slack.home_channel.id }}
SLACK_HOME_CHANNEL_NAME={{ agent_stack_hermes.slack.home_channel.name }}
{% endif %}

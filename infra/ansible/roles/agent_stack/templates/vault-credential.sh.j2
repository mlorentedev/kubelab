#!/bin/sh
# {{ ansible_managed }}
# Git's credential helper for the agent's vault clone. It answers only `get`,
# from the credential systemd hands the sync unit (LoadCredential). The token
# is never in the remote URL, the clone's config or a process argument.
[ "${1:-}" = get ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$CREDENTIALS_DIRECTORY/vault-token")"

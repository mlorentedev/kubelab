# {{ ansible_managed }}
# Mode 0600, root-owned: this file carries the OIDC client secret and the
# inference key. Nothing in compose-webui.yml repeats a value from it.
WEBUI_URL={{ agent_stack_webui.scheme }}://{{ agent_stack_webui.host }}:{{ agent_stack_webui.default_port }}
# The one origin pages are served from, for users and break-glass alike. The
# default `*` goes to Starlette with credentials on, which echoes any origin back,
# and socket.io takes the upgrade from any origin too (#2109).
CORS_ALLOW_ORIGIN={{ agent_stack_webui.scheme }}://{{ agent_stack_webui.host }}:{{ agent_stack_webui.default_port }}
WEBUI_SECRET_KEY={{ _agent_stack_webui_secret_key }}
# SQLite, WAL so readers never block the writer (ADR-068 D5).
DATABASE_ENABLE_SQLITE_WAL=true
# Env is the configuration of record. With persistent config on, Open WebUI
# reads most of these once, on an empty database, and a later edit here would
# change nothing while the play reported success.
ENABLE_PERSISTENT_CONFIG=false
# SSO against prod Authelia is the way in for people (ADR-062 human class).
# The form stays on as the break-glass door (ADR-062 D4): turning it off only
# hides it, since /api/v1/auths/signin keeps taking passwords (lesson-520).
# Nobody signs up through it, and the only local account is the one below.
ENABLE_LOGIN_FORM=true
ENABLE_SIGNUP=false
ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false
# An OIDC account is matched by its subject, and v0.11.4 keeps the email it was
# created with unless this is on. `make auth-review` keys each account to its
# login by email, so a stale address would read `undeclared` with no way to fix
# it. On, the next login takes Authelia's email. An address another account
# holds is not taken: v0.11.4 logs the conflict and the login goes on with the
# old email (utils/oauth.py), so a collision is a stale field, never a lockout.
OAUTH_UPDATE_EMAIL_ON_LOGIN=true
# The break-glass account. Seeded only on an empty database, before the first
# request is served, so no visitor can sign up as the first admin. Afterwards
# its password lives in Open WebUI's database: rotate it with
# `toolkit secrets rotate --group break-glass --env prod`, never here.
WEBUI_ADMIN_NAME=Break-glass
WEBUI_ADMIN_EMAIL={{ agent_stack_webui_admin_email }}
WEBUI_ADMIN_PASSWORD={{ agent_stack_webui_admin_password }}
# Tiers (ADR-062 D2): `admins` is admin, `users` is user, and a login in
# neither group is refused with a 403. The role is rewritten at every login.
ENABLE_OAUTH_ROLE_MANAGEMENT=true
OAUTH_ROLES_CLAIM=groups
OAUTH_ADMIN_ROLES=admins
OAUTH_ALLOWED_ROLES=users,admins
# Authelia sends `groups` only in UserInfo (lesson-457), and Open WebUI calls
# UserInfo only when the ID token lacks the email or the username claim. This
# username claim is never in Authelia's ID token, so UserInfo is always read.
OAUTH_USERNAME_CLAIM=preferred_username
OAUTH_PROVIDER_NAME=Authelia
OAUTH_CLIENT_ID={{ agent_stack_webui_oidc_client_id }}
OAUTH_CLIENT_SECRET={{ agent_stack_webui_oidc_client_secret }}
OPENID_PROVIDER_URL={{ agent_stack_oidc_issuer }}/.well-known/openid-configuration
OPENID_REDIRECT_URI={{ agent_stack_webui.scheme }}://{{ agent_stack_webui.host }}:{{ agent_stack_webui.default_port }}/oauth/oidc/callback
OAUTH_SCOPES=openid email profile groups
# Backends: NaN, then Hermes, at the address its compose file publishes on, the
# keys in the same order. Hermes runs exactly when the NaN key exists. Its models
# are granted to no one, so Open WebUI shows them to admins alone (AC4).
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API={{ (agent_stack_nan_api_key | length > 0) | lower }}
OPENAI_API_BASE_URLS={{ agent_stack_nan_api_base_url }}{% if agent_stack_hermes_configured | bool %};http://{{ _agent_stack_hermes_bind }}:{{ agent_stack_hermes.api_port }}/v1{% endif %}

OPENAI_API_KEYS={{ agent_stack_nan_api_key }}{% if agent_stack_hermes_configured | bool %};{{ _agent_stack_hermes_api_key }}{% endif %}

# Retrieval (spec AI-009 PR 5). Embeddings and reranking from NaN, so no local
# model loads. The reranker runs only on the hybrid-search path in v0.11.4, so
# hybrid search is on. It logs each query at INFO, and only GLOBAL_LOG_LEVEL
# could hide that: query text stays in ace2's local Docker logs, never shipped.
RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL={{ agent_stack_nan_api_base_url }}
RAG_OPENAI_API_KEY={{ agent_stack_nan_api_key }}
RAG_EMBEDDING_MODEL={{ agent_stack_webui.rag.embedding_model }}
RAG_EMBEDDING_BATCH_SIZE={{ agent_stack_webui.rag.embedding_batch_size }}
ENABLE_RAG_HYBRID_SEARCH=true
RAG_RERANKING_ENGINE=external
RAG_RERANKING_MODEL={{ agent_stack_webui.rag.reranking_model }}
RAG_EXTERNAL_RERANKER_URL={{ agent_stack_nan_api_base_url }}/rerank
RAG_EXTERNAL_RERANKER_API_KEY={{ agent_stack_nan_api_key }}

# {{ ansible_managed }}
# hermes-kubelab (ADR-068 D2, spec AI-009-hermes-ace2). Keys are those of
# {{ agent_stack_hermes.image }}. Mounted read-only into the gateway. No secret
# is written here: the keys it names live in the 0600 env file, which Compose
# reads on the host.
{#
  The keys ported from hermes-nan (spec AI-012 AC1), declared in the SSOT. The
  sections this file decides are rendered by hand below and take from it only
  the keys the role does not own; every other section is rendered as declared.
  JSON is YAML, so `tojson` writes each value as the SSOT typed it.
#}
{% set ported = agent_stack_hermes.agent_config %}
{% set role_sections = ['approvals', 'terminal', 'slack', 'unauthorized_dm_behavior', 'cron', 'model', 'delegation', 'fallback_providers', 'skills'] %}

model:
  provider: custom
  base_url: {{ agent_stack_nan_api_base_url }}
  key_env: NAN_API_KEY
  default: {{ agent_stack_hermes.models.default }}
{% for key, value in (ported.model | default({})).items() if key not in ['provider', 'base_url', 'key_env', 'default'] %}
  {{ key }}: {{ value | tojson }}
{% endfor %}
{% if agent_stack_anthropic_api_key | length > 0 %}

# When NaN fails (429 after retries, 5xx, 401/403, 404), an unpinned session
# moves here mid-turn (spec AI-012 AC2). Pinned scheduled and delegated work
# does not: a pinned route gets no inherited chain (v0.22.1 too).
fallback_providers:
  - provider: anthropic
    model: {{ agent_stack_hermes.models.fallback }}
{% endif %}

terminal:
  # Every command runs in a container on the agent's rootless daemon, never on
  # ace2 itself (C13), and receives none of the gateway's environment.
  backend: docker
  docker_image: {{ agent_stack_hermes.sandbox.image }}
  docker_forward_env: []
  container_cpu: {{ agent_stack_hermes.sandbox.cpus }}
  container_memory: {{ agent_stack_hermes.sandbox.memory_mb }}
  # No network until the sandbox has its own tailnet identity (ADR-068 D2,
  # `tag:hermes`). Through the rootless daemon it would leave as ace2, the
  # admin's node: measured 2026-10-06, it opened the VPS's :22 and :6443.
  docker_network: false
  # A host path here turns Hermes's command guards back on for the docker backend, approvals
  # included. The docs are always mounted (read-only, root's copy; spec AI-012 AC10), so the
  # guards are always on.
  docker_volumes:
{% if agent_stack_vault_configured | bool %}
    # The vault (ADR-068 D4 as amended 2026-10-08): read-only, and the agent's zone writable
    # inside it. The sync unit commits and pushes; the sandbox has no token and no network.
    - '{{ agent_stack_vault_clone }}:{{ agent_stack_hermes.vault_sync.mount }}:ro'
    - '{{ agent_stack_vault_clone }}/{{ agent_stack_vault_zone }}:{{ agent_stack_hermes.vault_sync.mount }}/{{ agent_stack_vault_zone }}:rw'
{% endif %}
    - '{{ agent_stack_docs_sandbox }}:{{ agent_stack_hermes.docs_mirror.mount }}:ro'

approvals:
  # Quoted: a bare `off` is YAML for false, which is how hermes-nan ended up
  # with no approvals at all.
  mode: "manual"
  timeout: 300
  # Nobody answers a scheduled job or an API call, so both deny rather than wait.
  cron_mode: "deny"
  unattended_mode: "deny"
  # files/guardrails-denylist.yaml. With no host path mounted into the sandbox,
  # the image skips every other command guard for the docker backend, the
  # prompts above included, and these globs are the one it still applies. With
  # the vault mounted, they apply after Hermes's own hardline floor.
  deny:
{% for rule in agent_stack_deny_rules %}
{% for glob in rule.globs %}
    - '{{ glob }}'
{% endfor %}
{% endfor %}

# A DM from anyone the allowlist does not name is dropped. The default answers
# it with a pairing code, and an approved code is a grant held in the gateway's
# state, outside this file.
unauthorized_dm_behavior: "ignore"

slack:
  unauthorized_dm_behavior: "ignore"
  # In the home channel, a top-level message must @mention the bot.
  require_mention: true

cron:
  # Jobs missed while ace2 was off run once at power-on (ADR-068 D2).
  catch_up_missed: true
  model: {{ agent_stack_hermes.models.unmetered }}

delegation:
  model: {{ agent_stack_hermes.models.unmetered }}
{% for key, value in (ported.delegation | default({})).items() if key != 'model' %}
  {{ key }}: {{ value | tojson }}
{% endfor %}

# The managed skills (spec AI-012 AC9) are an external directory: Hermes treats its
# skills as read-only to the agent and its curator, and ranks them below the agent's
# own. `external_dirs` is the role's, so the ported keys cannot point it elsewhere.
{% set skills = {} %}
{% for key, value in (ported.skills | default({})).items() if key != 'external_dirs' %}
{% set _ = skills.update({key: value}) %}
{% endfor %}
{% if agent_stack_vault_configured | bool and agent_stack_hermes.skills | default([]) | length > 0 %}
{% set _ = skills.update({'external_dirs': [agent_stack_hermes_skills_mount]}) %}
{% endif %}
skills: {{ skills | tojson }}

# The rest of the ported harness, as `apps.services.ai.hermes_kubelab.agent_config`
# declares it.
{% for section, value in ported.items() if section not in role_sections %}
{{ section }}: {{ value | tojson }}
{% endfor %}

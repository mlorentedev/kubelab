# {{ ansible_managed }}
# Holds the agent's user manager until Open WebUI's bridge has its address (spec
# AI-009 AC4). Hermes publishes its API on that address from the agent's
# rootless daemon, and the bridge belongs to the system daemon: at boot the
# user manager can start first, and a gateway created then runs with no port.
[Unit]
Description=Wait for Open WebUI's bridge before the agent's user manager
After=docker.service
Wants=docker.service
Before=user@{{ _agent_stack_agent_uid }}.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=180
ExecStart={{ agent_stack_dir }}/wait-for-tailscale-addr.sh {{ agent_stack_webui_bridge.gateway }} {{ agent_stack_webui_bridge.name }}

[Install]
# Wanted, not required: without the address the bind fails closed, so keeping
# the agent's manager down would protect nothing and cost the agent its work.
WantedBy=user@{{ _agent_stack_agent_uid }}.service

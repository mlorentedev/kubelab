{{ ansible_managed | comment }}
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    ports:
      web:
        port: {{ k3s_traefik_http_port }}
        exposedPort: {{ k3s_traefik_http_port }}
      websecure:
        port: {{ k3s_traefik_https_port }}
        exposedPort: {{ k3s_traefik_https_port }}
      # SEC-005: `expose.default` MUST stay false. The Traefik chart ships it
      # false; this template set it true, which put the dashboard port into a
      # LoadBalancer Service -- and klipper-lb publishes EVERY port of a
      # LoadBalancer Service as a hostPort with SRC_RANGES=0.0.0.0/0. Because a
      # DNAT-published port is evaluated in PREROUTING, ufw never saw it, so
      # `http://<vps>:9000/api/overview` answered 200 to the public internet,
      # unauthenticated, exposing the whole routing topology (#1538).
      #
      # The container still LISTENS on 9000 -- `ports.traefik.port` below is the
      # container port, and both probes target it directly rather than the
      # Service, so removing it from the Service changes nothing for them. What
      # goes away is the published host port and nothing else.
      #
      # The dashboard's supported path is the IngressRoute at traefik.<domain>,
      # which reaches `api@internal` and sits behind Authelia. Do not re-expose
      # this port to give something in-cluster an unauthenticated shortcut.
      traefik:
        port: 9000
        expose:
          default: false
        exposedPort: 9000
    # Declared here so the kube-system LimitRange default never sizes the ingress
    # (OBS-043). Memory follows open connections, not traffic at rest.
    resources:
      requests:
        memory: {{ k3s_traefik_memory_request }}
      limits:
        memory: {{ k3s_traefik_memory_limit }}
    # Liveness answers from the process that carries the traffic, so the chart's
    # 2-second timeout and 30-second window restarted a saturated Traefik (OPS-063).
    livenessProbe:
      timeoutSeconds: {{ k3s_traefik_liveness_timeout_seconds }}
      periodSeconds: {{ k3s_traefik_liveness_period_seconds }}
      failureThreshold: {{ k3s_traefik_liveness_failure_threshold }}
    # One replica: unready removes the only endpoint, so a single slow answer is not enough.
    readinessProbe:
      timeoutSeconds: {{ k3s_traefik_liveness_timeout_seconds }}
      failureThreshold: 3
    # Only requests slower than the declared duration, so that a bound on how long
    # Traefik waits for a backend is sized from what routes really take (OPS-065).
    # Fields are an allowlist: the path carries the query string, and no credential
    # may reach Loki (SEC-021), so a route is named by router and service only.
    logs:
      access:
        enabled: true
        format: json
        filters:
          minduration: "{{ k3s_traefik_access_log_min_duration }}"
          # ORed with minduration by Traefik: every server error, fast or slow,
          # which the 5xx alerts in grafana-alerting/slo-rules.yaml count (#3140).
          statuscodes: "500-599"
        fields:
          general:
            defaultmode: drop
            names:
              RouterName: keep
              ServiceName: keep
              RequestMethod: keep
              DownstreamStatus: keep
              OriginStatus: keep
              Duration: keep
              OriginDuration: keep
          headers:
            defaultmode: drop
    persistence:
      enabled: true
      storageClass: local-path
      size: 128Mi
    experimental:
      # Local plugins only (#2565): the role puts each source on the node, so a start
      # downloads nothing. A plugin that then fails to load stops Traefik instead of
      # starting it without the routes that use it; the rolling update
      # (maxUnavailable: 0) keeps the old pod serving while a new one fails.
      abortOnPluginFailure: true
      localPlugins:
{% for plugin in k3s_traefik_local_plugins %}
        {{ plugin.name }}:
          type: hostPath
          moduleName: "{{ plugin.module }}"
          mountPath: "/plugins-local/src/{{ plugin.module }}"
          hostPath: "{{ k3s_traefik_local_plugins_dir }}/{{ plugin.name }}/{{ plugin.version }}"
{% endfor %}
    volumes:
      - name: crowdsec-bouncer-traefik
        mountPath: "/etc/traefik/crowdsec"
        type: secret
    additionalArguments:
      # The edge stops waiting for a backend's headers after a bound (ADR-076).
      # A route that needs longer references a ServersTransport of its own,
      # declared in `edge.backend_timeouts.exceptions` (common.yaml).
      - "--serversTransport.forwardingTimeouts.responseHeaderTimeout={{ k3s_traefik_response_header_timeout }}"
      - "--serversTransport.forwardingTimeouts.dialTimeout={{ k3s_traefik_dial_timeout }}"
{% if k3s_traefik_acme_enabled %}
      # `api.dashboard` serves the dashboard through `api@internal`, which is
      # reachable only via an IngressRoute -- so it inherits that route's
      # middlewares, Authelia included.
      #
      # `api.insecure` is deliberately absent (SEC-005 / #1538). It served the
      # full API on the `traefik` entrypoint with NO authentication of any kind.
      # That was survivable only while nothing could reach port 9000 from
      # outside, and nothing enforced that: see the `expose.default: false`
      # comment above for why the port was in fact public. Re-adding this flag
      # re-creates an unauthenticated API the moment any path to 9000 exists,
      # so it is left out rather than paired with a second control.
      - "--api.dashboard=true"
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge.provider={{ k3s_traefik_acme_dns_provider }}"
      - "--certificatesresolvers.letsencrypt.acme.email={{ k3s_traefik_acme_email }}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/data/acme.json"
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge.resolvers={{ k3s_traefik_acme_dns_resolvers }}"
{% if not k3s_traefik_acme_propagation_checks | bool %}
      # See k3s_traefik_acme_propagation_checks: the site may answer the
      # authoritative check itself, so wait instead of asking (#2699).
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge.propagation.disableChecks=true"
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge.propagation.delayBeforeChecks=60s"
{% endif %}
      - "--entrypoints.web.http.redirections.entryPoint.to=websecure"
      - "--entrypoints.web.http.redirections.entryPoint.scheme=https"
      - "--entrypoints.web.http.redirections.entryPoint.permanent=true"
    providers:
      kubernetesCRD:
        allowCrossNamespace: true
    env:
      - name: CF_DNS_API_TOKEN
        valueFrom:
          secretKeyRef:
            name: {{ k3s_traefik_acme_secret_name }}
            key: api-token
{% endif %}

#!/bin/bash
# {{ ansible_managed }}
# BACKUP-044 Part 3 -- ships {{ inventory_hostname }}'s staged capture to R2
# via restic, one repository per node. Reads FROM the capture unit's staging
# dir; never touches the live source paths itself.
#
# `restic check` is expensive relative to backup/forget (Part 0's approved
# operating parameters: weekly, not per-run, for 16x headroom on repository
# growth as it grows). Part 4's weekly timer instance invokes this script
# with --check; its frequent (hourly/4h) instance does not -- the capability
# lives here so Part 4 only has to wire the schedule.
set -euo pipefail

RUN_CHECK=0
[ "${1:-}" = "--check" ] && RUN_CHECK=1

STAGING="{{ node_backup_staging_dir }}"
if [ ! -d "$STAGING" ] || [ -z "$(ls -A "$STAGING" 2>/dev/null)" ]; then
    echo "node-backup-ship: staging dir empty or missing ($STAGING) -- capture did not run first" >&2
    exit 1
fi

# A populated staging dir proves capture STARTED. It does not prove capture
# FINISHED -- a run that dies on the third of four sources leaves a directory
# that looks entirely healthy, and shipping it stores a partial backup that is
# indistinguishable from a whole one at restore time. That is the worst
# failure mode this pipeline has: not an absent backup, which is loud, but a
# present one that is short.
#
# The unit's `After=` only ORDERS the two; it does not require capture to have
# succeeded. Checked here rather than as `Requires=` on the unit, because a
# hard unit requirement would re-run capture on every ship start (both are
# oneshots) and so decide Part 4's timer topology from Part 3. It also catches
# a hand-invoked script, which no unit dependency would.
SENTINEL="{{ node_backup_capture_sentinel }}"
if [ ! -f "$SENTINEL" ]; then
    echo "node-backup-ship: no capture sentinel ($SENTINEL) -- capture did not COMPLETE; refusing to ship a partial backup" >&2
    exit 1
fi

# Credentials from root-owned files, never argv or a literal in this script:
# ANSIBLE-038's pattern (also used by kubelab-notify.sh) -- argv
# is readable via `ps` / /proc/<pid>/cmdline for the life of the call. restic
# and the AWS SDK it embeds both read these as plain environment variables,
# which /proc/<pid>/environ restricts to the owning user (root, here) --
# consistent with the risk this node already accepts for a root oneshot.
export RESTIC_PASSWORD="$(cat {{ node_backup_restic_password_file }})"
export AWS_ACCESS_KEY_ID="$(cat {{ node_backup_r2_access_key_file }})"
export AWS_SECRET_ACCESS_KEY="$(cat {{ node_backup_r2_secret_key_file }})"

REPO="{{ node_backup_r2_repository }}"
# `--stuck-request-timeout` bounds how long restic waits on a request that is
# going nowhere before retrying it. Measured 2026-08-22 on beelink: with
# restic's 5m default, a blackholed endpoint surfaced as systemd
# `Result=timeout` with NOT ONE restic error line in the journal. 45s is well
# above any healthy request to R2 (a full cycle on this fleet is 2-12s end to
# end) and well under the unit's ceiling.
#
# It does NOT end a run whose requests are refused, and a bad credential is
# refused: see the probe below (#1939).
RESTIC="{{ node_backup_restic_install_path }} --repo $REPO --stuck-request-timeout {{ node_backup_stuck_request_timeout }}"

# --- which repository, and may we create one (BACKUP-058) ------------------
# This used to run `restic init` whenever `snapshots` failed, for ANY reason.
# A deleted repository therefore came back as a fresh one holding one
# snapshot, the watcher called it healthy, and every earlier restore point was
# gone with nothing paging. `init` is now reachable from exactly one state: a
# repository that does not exist, on a node that has never shipped to it.
#
# The node's memory of "I have shipped here" is MARKER, holding the restic
# repository id (new for every `init`, fixed otherwise). The ROLE never writes
# it; this script does, once a snapshot is written. `make backup-repo-reinit` is the
# only sanctioned way to remove it.
MARKER="{{ node_backup_r2_repository_id_file }}"
DESTINATION="r2"
REINIT="make backup-repo-reinit NODE={{ inventory_hostname }} DEST=$DESTINATION ENV={{ node_backup_env }}"
# A marker that EXISTS says "this node has shipped here", whatever it holds.
# Reading an empty or corrupt one as absent would make `init` reachable again
# for a deleted repository -- the silent re-init this guard exists to stop.
# Nothing here writes a blank marker (the write below is atomic), so one comes
# from outside (a `touch`, a restore that truncates): refuse, never guess.
# `-L` as well, because `-e` is false for a symlink whose target is gone. An
# unreadable marker reads as empty, so it gets the message below rather than
# a bare `set -e` abort that names neither the marker nor the way out.
RECORDED=""
if [ -e "$MARKER" ] || [ -L "$MARKER" ]; then
    RECORDED="$(tr -d '[:space:]' < "$MARKER" 2>/dev/null)" || RECORDED=""
    case "$RECORDED" in
        ''|*[!0-9a-f]*)
            echo "node-backup-ship: $MARKER exists but holds no repository id ('$RECORDED')." >&2
            echo "  Its presence means this node has shipped to $DESTINATION, so it cannot be read as a first" >&2
            echo "  ship. Find out what rewrote it. If forgetting the recorded repository is the decision, run:" >&2
            echo "    $REINIT" >&2
            exit 1 ;;
    esac
fi

# stderr is KEPT, and that is the fix rather than a detail. This probe is the
# FIRST thing to touch R2, so it is where a bad credential or an unreachable
# endpoint is discovered -- and discarding its stderr threw away the only
# explanation the run would ever produce. stdout still goes to /dev/null (a
# snapshot list is not evidence of anything here); stderr is replayed to the
# journal whatever happens, where the notifier reads it.
#
# The probe carries its own bound because restic never gives up on a refused
# request in time. R2 answers a bad credential with 401 `Unauthorized` (400
# `InvalidArgument` for a malformed key), restic 0.19.1's S3 backend treats
# only `AccessDenied` and `InvalidRange` as permanent, and it retries anything
# else for 15 minutes -- past the unit's 600s, so systemd used to kill it with
# a journal full of retries and no verdict (measured 2026-09-30, #1939). Each
# retry line names R2's reason, so on timeout the last one IS the verdict.
#
# The exit code is taken inside the `if`, because `set -e` would abort on a
# bare failing command before `$?` could be read.
PROBE_ERR="$(mktemp)"
trap 'rm -f "$PROBE_ERR"' EXIT
if timeout -k 10 {{ node_backup_probe_timeout }} $RESTIC snapshots -q >/dev/null 2>"$PROBE_ERR"; then
    SNAPSHOTS_RC=0
else
    SNAPSHOTS_RC=$?
fi
cat "$PROBE_ERR" >&2
PROBE_REFUSAL="$(sed -n 's/^.* returned error, retrying after [^:]*: //p' "$PROBE_ERR" | tail -n 1)"
rm -f "$PROBE_ERR"

# 10 is restic's "repository does not exist" (restic >= 0.17). Measured against
# R2 with this fleet's restic 0.19.1 on 2026-09-30: a missing repository
# returns 10, a wrong password 12, and an invalid credential never returns at
# all, so it ends as `timeout`'s 124 (137 if it needed the kill) -- no
# credential or network failure can reach `init`.
case "$SNAPSHOTS_RC" in
    0) ;;
    10)
        if [ -n "$RECORDED" ]; then
            echo "node-backup-ship: the $DESTINATION repository this node has shipped to ($RECORDED) no longer exists." >&2
            echo "  Refusing to initialise a new one: that would replace the whole restore history with a single" >&2
            echo "  snapshot, silently. Find out what deleted it first. If starting over is the decision, run:" >&2
            echo "    $REINIT" >&2
            echo "  then declare the new repository id in backup.r2.repository_ids (common.yaml) in a PR." >&2
            exit 1
        fi
        echo "node-backup-ship: no $DESTINATION repository yet and none recorded -- first ship, initialising"
        $RESTIC init ;;
    124|137)
        if [ -n "$PROBE_REFUSAL" ]; then
            echo "node-backup-ship: restic was still retrying $DESTINATION after {{ node_backup_probe_timeout }}s, last error: $PROBE_REFUSAL" >&2
            case "$PROBE_REFUSAL" in
                *Unauthorized*|*AccessDenied*|*InvalidAccessKeyId*|*SignatureDoesNotMatch*|*"Credential access key"*)
                    echo "  That is R2 rejecting this node's credential (backup.r2.access_key_id / secret_access_key)." >&2
                    echo "  restic retries it for 15 minutes rather than failing, hence this bound (#1939)." >&2 ;;
            esac
        else
            echo "node-backup-ship: no answer from $DESTINATION within {{ node_backup_probe_timeout }}s and no error from restic -- endpoint unreachable or stalled" >&2
        fi
        exit "$SNAPSHOTS_RC" ;;
    *)
        echo "node-backup-ship: $DESTINATION repository not readable (restic exit $SNAPSHOTS_RC, see its error above) -- not initialising" >&2
        exit "$SNAPSHOTS_RC" ;;
esac

# Compared on EVERY ship, not only the first: a replaced repository answers
# `snapshots` with 0, so this comparison is the only thing that sees it. One
# small read per run; do not optimise it away.
if ! CONFIG="$($RESTIC cat config --json)"; then
    echo "node-backup-ship: 'restic cat config' failed on the $DESTINATION repository (see its error above)" >&2
    exit 1
fi
# Same extraction as the watcher's probe.sh (r2-backup-watcher): the two must
# agree on which field is the id, so change them together.
REPOSITORY_ID="$(printf '%s\n' "$CONFIG" | sed -n 's/^.*"id": *"\([0-9a-f]*\)".*$/\1/p')"
case "$REPOSITORY_ID" in
    ''|*[!0-9a-f]*)
        echo "node-backup-ship: could not read the $DESTINATION repository id from 'restic cat config'" >&2
        exit 1 ;;
esac
if [ -n "$RECORDED" ] && [ "$RECORDED" != "$REPOSITORY_ID" ]; then
    echo "node-backup-ship: the $DESTINATION repository was replaced: this node has shipped to $RECORDED," >&2
    echo "  the repository there now is $REPOSITORY_ID. Refusing to write into a history that is not this" >&2
    echo "  node's. If accepting the new repository is the decision, run:" >&2
    echo "    $REINIT" >&2
    echo "  then declare the new repository id in backup.r2.repository_ids (common.yaml) in a PR." >&2
    exit 1
fi

$RESTIC backup "$STAGING" --tag "{{ inventory_hostname }}"

# Recorded as soon as `backup` succeeds: from that moment the repository holds a
# restore point, so it is a history this node must never silently replace, even
# if `forget` or `check` below then fails the run. Never before `backup`, so a
# repository that holds nothing is never pinned. Atomic (write, then rename) so
# a torn write is never read back as an id, and through `mktemp` because the
# frequent and weekly units can reach this line at the same time.
if [ -z "$RECORDED" ]; then
    MARKER_TMP="$(mktemp "$MARKER.XXXXXX")"
    printf '%s\n' "$REPOSITORY_ID" > "$MARKER_TMP"
    mv -f "$MARKER_TMP" "$MARKER"
    echo "recorded $DESTINATION repository $REPOSITORY_ID in $MARKER"
fi

# Retention approved by the operator 2026-08-16 (tasks.md "Approved operating
# parameters"): ~a year of restore points, baked in rather than passed at
# call time so a scheduled run always carries the ratified policy.
$RESTIC forget {{ node_backup_retention_flags }} --prune

if [ "$RUN_CHECK" -eq 1 ]; then
    $RESTIC check
fi

echo "ship complete: $REPO"

# --- shutdown receipt ------------------------------------------------------
# Written only when this run was invoked by the shutdown unit's ExecStop, which
# is the one path whose journal does not survive: the persistent journal stops
# recording when the user session closes, well before systemd stops system
# services (measured across a real power cycle, 2026-08-22).
#
# `$INVOCATION_ID` and `$SYSTEMD_UNIT` come from systemd itself, so this cannot
# fire for a hand-run script or for the timer. The receipt is one line, on the
# disk this run just captured from, and the next boot reads it back.
if [ "${SHUTDOWN_RECEIPT:-}" != "" ]; then
    printf '%s ship=ok repo=%s\n' "$(date -Iseconds)" "$REPO" > "$SHUTDOWN_RECEIPT" 2>/dev/null || true
fi

# --- coverage heartbeat (BACKUP-044 AC9) ----------------------------------
# LAST, and reached only on success: `set -e` aborts above on any failure, so
# silence at the far end means no backup completed. That is the whole design --
# the watcher is Uptime Kuma on the RPi3, outside this node's failure domain,
# and it reports a run that NEVER STARTED, which no check on the runs that do
# exist can ever see.
#
# It must NOT fail this unit, and that is the load-bearing decision here.
# A 5xx from Kuma, or CrowdSec banning this node's IP -- which is in this very
# request path -- would otherwise fire `OnFailure=` and page "backup failed"
# about a backup that succeeded. That is the inverse of the defect fixed in
# #1216, where the title claimed failure over healthy state.
#
# Nothing is lost by not failing: a heartbeat that does not arrive is exactly
# what the monitor exists to notice, so the failure mode of this call IS the
# signal. It reports itself, 6h later, through the control it belongs to.
if [ -f "{{ node_backup_heartbeat_token_file }}" ]; then
    HEARTBEAT_TOKEN="$(cat {{ node_backup_heartbeat_token_file }})"
    # Validated, not escaped. `secrets.token_urlsafe` yields [A-Za-z0-9_-] only,
    # so anything else means a corrupted or hand-edited file -- and this value
    # is interpolated into a URL path, where a stray character would silently
    # address a different monitor rather than fail.
    case "$HEARTBEAT_TOKEN" in
        ''|*[!A-Za-z0-9_-]*)
            echo "node-backup-ship: heartbeat token is not a plausible push token; skipping" >&2 ;;
        *)
            # The token goes to curl through a config on STDIN, never as an argv
            # element -- ANSIBLE-038 f4. The push endpoint takes it in the URL
            # PATH, so `-o /dev/null <url>` would put a live credential in
            # `ps` / /proc/<pid>/cmdline for the life of the call. `url =` in a
            # config file is curl's own answer to that.
            #
            # Bounded like every other outbound call in this fleet (f1), with a
            # retry budget deliberately smaller than the notifier's: this runs
            # inside the ship unit's TimeoutStartSec and must not eat into it.
            if printf 'url = "https://{{ node_backup_heartbeat_domain }}/api/push/%s"\n' \
                 "$HEARTBEAT_TOKEN" \
               | curl -sS -f --config - \
                   --connect-timeout 5 --max-time 10 \
                   --retry 2 --retry-delay 3 --retry-connrefused --retry-max-time 12 \
                   -o /dev/null; then
                echo "coverage heartbeat posted"
            else
                echo "node-backup-ship: heartbeat POST failed. The backup itself SUCCEEDED --" >&2
                echo "  this unit is not failing over it. The missed heartbeat is its own" >&2
                echo "  alert: the coverage monitor reports it after its window." >&2
            fi ;;
    esac
fi

#!/bin/bash
# {{ ansible_managed }}
# BACKUP-044 Part 3 -- captures {{ inventory_hostname }}'s declared sources
# (common.yaml backup.sources.{{ inventory_hostname }}) into a staging
# directory. Ship (a separate unit/script) reads FROM this staging dir; this
# script never talks to R2.
#
# Every source below was rendered from the SSOT at Ansible-apply time -- this
# script has no YAML parsing and no per-run discovery, so a source added to
# common.yaml takes effect on the next `make deploy` / `make apply-secrets`
# cycle, not by editing this file.
set -euo pipefail

# --- read back the previous shutdown's receipt -----------------------------
# A receipt nobody reads is a file, not a control. This runs at BOOT (the
# capture unit is Before=docker.service on on-demand nodes), which is the first
# moment anyone can learn whether the last power-off shipped.
#
# Absence is the finding, and it is why the shutdown unit deletes the file
# before trying: a stale receipt from two shutdowns ago would read as success.
{% if node_backup_location == 'on-demand' %}
# Once per boot, not once per run. Ship pulls this script in via `Wants=` on
# every hourly tick, and "did the last power-off ship" is a question with one
# answer per boot -- asking it hourly turns one fact into a stream. The flag
# lives on tmpfs, so the kernel resets it and nothing has to remember to.
if [ ! -e "{{ node_backup_boot_check_flag }}" ]; then
    if [ -f "{{ node_backup_shutdown_receipt }}" ]; then
        echo "previous shutdown snapshot: $(cat {{ node_backup_shutdown_receipt }})"
    elif [ -f "{{ node_backup_shutdown_attempt_marker }}" ]; then
        # The marker exists and the receipt does not: ExecStop RAN and ship
        # failed inside it. This is the failure the control was written for,
        # and the only one of the three branches that belongs on stderr.
        echo "previous shutdown snapshot: the shutdown sequence RAN and did NOT ship." >&2
        echo "  This session's boot capture covers the previous session, so nothing is" >&2
        echo "  lost yet; but a node that never comes back would have left its last" >&2
        echo "  session only in this snapshot. See BACKUP-044 AC5." >&2
    else
        # Neither file: no shutdown sequence ran. On this fleet that is the
        # NORMAL path -- the homelab is powered down by smart plug, so
        # `ExecStop=` never executes. Reporting it as a failure every boot is
        # what made this line meaningless before; the boot capture below is
        # the mitigation, and it is about to run.
        echo "previous power-off was unclean (no shutdown sequence ran) — this boot's capture covers it."
    fi

    # Clear BOTH, so the next boot reads this boot's outcome and never an
    # older one. Leaving it to the shutdown unit is what the previous revision
    # did, and that only works when the shutdown unit runs: after a smart-plug
    # cut a receipt from the last clean reboot would survive and be read as
    # proof that the power-off shipped. Absence is the signal, so the signal
    # has to be reset by something a power cut cannot skip.
    rm -f "{{ node_backup_shutdown_receipt }}" "{{ node_backup_shutdown_attempt_marker }}"
    : > "{{ node_backup_boot_check_flag }}"
fi
{% endif %}

STAGING="{{ node_backup_staging_dir }}"
rm -rf "$STAGING"
mkdir -p "$STAGING"

{% for service, src in node_backup_sources.items() %}
# --- {{ service }} {{ '(bind mount)' if src.path is defined else ('(PVC: ' ~ src.pvc.namespace ~ '/' ~ src.pvc.claim ~ ', local-path on this node)' if src.pvc is defined else '(Docker volume: ' ~ src.volume ~ ')') }} ---
mkdir -p "$STAGING/{{ service }}"
{% if src.path is defined %}
SRC_DIR_{{ service }}="{{ src.path }}"
{% elif src.pvc is defined %}
# A Kubernetes PVC on `local-path`, which is a directory on THIS node -- so the
# node-path pipeline reaches it and no in-cluster job is needed.
#
# The path is RESOLVED, never hardcoded, and that is the load-bearing part:
# local-path embeds the claim's UID, e.g.
#   <k3s storage root>/pvc-<claim-uid>_<namespace>_<claim>
# A recreated PVC gets a new UID and a new directory, while the old one stays
# on disk looking perfectly healthy. Hardcoding would keep archiving the dead
# copy and reporting success -- the silent failure this pipeline exists to end.
#
# Read through the kubeconfig this node already has as a k3s server. `|| true`
# plus the emptiness check below rather than `set -e` doing it: a PVC that is
# genuinely gone must fail LOUDLY here, naming the claim, instead of failing
# three lines later on a `cd` into an empty string.
SRC_DIR_{{ service }}="$(KUBECONFIG=/etc/rancher/k3s/k3s.yaml kubectl get pv \
    -o jsonpath='{range .items[?(@.spec.claimRef.namespace=="{{ src.pvc.namespace }}")]}{.spec.claimRef.name}{"\t"}{.spec.local.path}{"\n"}{end}' \
    2>/dev/null | awk -F'\t' '$1 == "{{ src.pvc.claim }}" { print $2 }' || true)"
if [ -z "$SRC_DIR_{{ service }}" ]; then
    echo "node-backup-capture: no local-path PV bound to {{ src.pvc.namespace }}/{{ src.pvc.claim }} -- refusing to ship a backup that silently omits it" >&2
    exit 1
fi
{% else %}
SRC_DIR_{{ service }}="$(docker volume inspect {{ src.volume }} --format '{{ '{{' }}.Mountpoint{{ '}}' }}')"
{% endif %}

# Live SQLite snapshot: `.backup` is WAL-aware and produces a single
# consistent file, unlike a raw copy of a database mid-write (Part 0
# measured this by accident -- a payload that shrank across a reboot because
# the restart checkpointed the WAL). Staged at the SAME relative path it has
# in the source (not just the basename), so a restore is a plain reverse
# copy with no per-service path table to keep in sync.
#
# `.backup` being WAL-aware is a property of `.backup`, and for four years
# nothing checked it was also true of the DATABASE. Measured 2026-09-04 across
# all six declared sources: four were in WAL by each application's default,
# and two -- beelink/gitea and prod/authelia -- were in rollback-journal mode,
# where a writer's commit takes an EXCLUSIVE lock that refuses readers. Gitea
# failed that morning at 06:23:58 with "database is locked" while act_runner
# posted UpdateTask every second for a running job.
#
# Two defences, and this is the second. The first is declaring WAL where the
# application allows it. This one covers the rest -- an application with no
# such setting, and the SQLITE_BUSY a WAL checkpoint can still return -- by
# waiting instead of failing at the first contended instant. `.timeout` is
# passed via `-cmd` so it is set BEFORE `.backup` runs; a `PRAGMA` after the
# fact would be too late.
#
# The retry is not redundant with the timeout: the CLI's `.backup` can return
# SQLITE_BUSY from a backup STEP rather than from the initial open, which the
# timeout does not cover on every build. Three attempts over ~35s against a
# capture that runs hourly -- a partial backup is refused downstream, so the
# cost of trying again is strictly lower than the cost of not.
mkdir -p "$(dirname "$STAGING/{{ service }}/{{ src.sqlite }}")"
capture_sqlite_{{ service }}() {
    local attempt
    for attempt in 1 2 3; do
        if sqlite3 -cmd ".timeout 10000" \
                   "$SRC_DIR_{{ service }}/{{ src.sqlite }}" \
                   ".backup '$STAGING/{{ service }}/{{ src.sqlite }}'"; then
            [ "$attempt" -gt 1 ] && echo "{{ service }}: .backup succeeded on attempt ${attempt}"
            return 0
        fi
        echo "{{ service }}: .backup attempt ${attempt}/3 failed (database contended); retrying" >&2
        sleep $(( attempt * 5 ))
    done
    # Names the service. The bare sqlite3 error is "Error: database is locked"
    # and nothing else -- on a node with one source that is merely unhelpful,
    # on the VPS with three it leaves you guessing which one.
    echo "node-backup-capture: {{ service }} ({{ src.sqlite }}): .backup failed 3 times -- database stayed locked" >&2
    return 1
}
capture_sqlite_{{ service }}

# Everything else in the source directory, verbatim -- e.g. Headscale's
# noise_private.key and derp_server_private.key, which are not databases but
# are exactly as unrecoverable as one. Excludes the live db and its WAL/SHM
# siblings: the db is already captured consistently above, and a raw copy of
# its WAL segments belongs to a snapshot the copy cannot produce.
#
# `cd` first and match relative (./...) paths: `cp --parents` on an absolute
# source path recreates the ENTIRE path under the destination
# ($STAGING/{{ service }}/opt/gitea/data/...), not the source's own tree --
# verified against a scratch fixture. Relative paths preserve just the
# source's internal structure, which is what a restore needs to reproduce.
( cd "$SRC_DIR_{{ service }}" && find . -mindepth 1 \
    ! -path "./{{ src.sqlite }}" \
    ! -path "./{{ src.sqlite }}-wal" \
    ! -path "./{{ src.sqlite }}-shm" \
    -exec cp -a --parents -t "$STAGING/{{ service }}" {} + )
{% endfor %}

# Success sentinel, written LAST and reached only if every source above
# completed: `set -e` aborts this script before this line on any failure, so
# the file's presence is the only in-band evidence that the capture is whole
# rather than partial. Ship refuses without it.
#
# A stale sentinel cannot survive a failed re-run -- this script `rm -rf`s the
# staging dir at the top, so a capture that dies halfway leaves a populated
# directory with NO sentinel, which is exactly the state ship must reject.
# It ships inside the snapshot too, which is a small bonus: a restored
# snapshot carries its own proof that the capture behind it finished.
touch "{{ node_backup_capture_sentinel }}"

echo "capture complete: $(du -sh "$STAGING" | cut -f1)"

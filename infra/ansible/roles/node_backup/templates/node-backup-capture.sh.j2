#!/bin/bash
# {{ ansible_managed }}
# BACKUP-044 Part 3 -- captures {{ inventory_hostname }}'s declared sources
# (common.yaml backup.sources.{{ inventory_hostname }}) into a staging
# directory. Ship (a separate unit/script) reads FROM this staging dir; this
# script never talks to R2.
#
# Every source below was rendered from the SSOT at Ansible-apply time -- this
# script has no YAML parsing and no per-run discovery, so a source added to
# common.yaml takes effect on the next `make deploy` / `make apply-secrets`
# cycle, not by editing this file.
set -euo pipefail

STAGING="{{ node_backup_staging_dir }}"
rm -rf "$STAGING"
mkdir -p "$STAGING"

{% for service, src in node_backup_sources.items() %}
# --- {{ service }} {{ '(bind mount)' if src.path is defined else ('(PVC: ' ~ src.pvc.namespace ~ '/' ~ src.pvc.claim ~ ', local-path on this node)' if src.pvc is defined else '(Docker volume: ' ~ src.volume ~ ')') }} ---
mkdir -p "$STAGING/{{ service }}"
{% if src.path is defined %}
SRC_DIR_{{ service }}="{{ src.path }}"
{% elif src.pvc is defined %}
# A Kubernetes PVC on `local-path`, which is a directory on THIS node -- so the
# node-path pipeline reaches it and no in-cluster job is needed.
#
# The path is RESOLVED, never hardcoded, and that is the load-bearing part:
# local-path embeds the claim's UID, e.g.
#   <k3s storage root>/pvc-<claim-uid>_<namespace>_<claim>
# A recreated PVC gets a new UID and a new directory, while the old one stays
# on disk looking perfectly healthy. Hardcoding would keep archiving the dead
# copy and reporting success -- the silent failure this pipeline exists to end.
#
# Read through the kubeconfig this node already has as a k3s server. `|| true`
# plus the emptiness check below rather than `set -e` doing it: a PVC that is
# genuinely gone must fail LOUDLY here, naming the claim, instead of failing
# three lines later on a `cd` into an empty string.
SRC_DIR_{{ service }}="$(KUBECONFIG=/etc/rancher/k3s/k3s.yaml kubectl get pv \
    -o jsonpath='{range .items[?(@.spec.claimRef.namespace=="{{ src.pvc.namespace }}")]}{.spec.claimRef.name}{"\t"}{.spec.local.path}{"\n"}{end}' \
    2>/dev/null | awk -F'\t' '$1 == "{{ src.pvc.claim }}" { print $2 }' || true)"
if [ -z "$SRC_DIR_{{ service }}" ]; then
    echo "node-backup-capture: no local-path PV bound to {{ src.pvc.namespace }}/{{ src.pvc.claim }} -- refusing to ship a backup that silently omits it" >&2
    exit 1
fi
{% else %}
SRC_DIR_{{ service }}="$(docker volume inspect {{ src.volume }} --format '{{ '{{' }}.Mountpoint{{ '}}' }}')"
{% endif %}

# Live SQLite snapshot: `.backup` is WAL-aware and produces a single
# consistent file, unlike a raw copy of a database mid-write (Part 0
# measured this by accident -- a payload that shrank across a reboot because
# the restart checkpointed the WAL). Staged at the SAME relative path it has
# in the source (not just the basename), so a restore is a plain reverse
# copy with no per-service path table to keep in sync.
mkdir -p "$(dirname "$STAGING/{{ service }}/{{ src.sqlite }}")"
sqlite3 "$SRC_DIR_{{ service }}/{{ src.sqlite }}" ".backup '$STAGING/{{ service }}/{{ src.sqlite }}'"

# Everything else in the source directory, verbatim -- e.g. Headscale's
# noise_private.key and derp_server_private.key, which are not databases but
# are exactly as unrecoverable as one. Excludes the live db and its WAL/SHM
# siblings: the db is already captured consistently above, and a raw copy of
# its WAL segments belongs to a snapshot the copy cannot produce.
#
# `cd` first and match relative (./...) paths: `cp --parents` on an absolute
# source path recreates the ENTIRE path under the destination
# ($STAGING/{{ service }}/opt/gitea/data/...), not the source's own tree --
# verified against a scratch fixture. Relative paths preserve just the
# source's internal structure, which is what a restore needs to reproduce.
( cd "$SRC_DIR_{{ service }}" && find . -mindepth 1 \
    ! -path "./{{ src.sqlite }}" \
    ! -path "./{{ src.sqlite }}-wal" \
    ! -path "./{{ src.sqlite }}-shm" \
    -exec cp -a --parents -t "$STAGING/{{ service }}" {} + )
{% endfor %}

# Success sentinel, written LAST and reached only if every source above
# completed: `set -e` aborts this script before this line on any failure, so
# the file's presence is the only in-band evidence that the capture is whole
# rather than partial. Ship refuses without it.
#
# A stale sentinel cannot survive a failed re-run -- this script `rm -rf`s the
# staging dir at the top, so a capture that dies halfway leaves a populated
# directory with NO sentinel, which is exactly the state ship must reject.
# It ships inside the snapshot too, which is a small bonus: a restored
# snapshot carries its own proof that the capture behind it finished.
touch "{{ node_backup_capture_sentinel }}"

echo "capture complete: $(du -sh "$STAGING" | cut -f1)"

# {{ ansible_managed }}
[Unit]
Description=BACKUP-044 node-backup ship to R2{{ ' with integrity check' if node_backup_check else '' }} ({{ inventory_hostname }})
# BACKUP-044 Part 5, AC4. `%n` rather than a literal, which is what lets ONE
# line cover both renderings of this template: the frequent ship unit and the
# weekly integrity-check instance report under their own names.
#
# A failed capture therefore produces TWO envelopes: capture's own, and this
# unit's when it refuses on the missing sentinel. Deliberate, not an oversight.
# They are different claims -- "capture failed" and "the guard against shipping
# a partial backup held" -- from two units with two journals, at `log` severity
# rather than a page. Suppressing the second would mean the only in-band
# evidence that the sentinel worked is its absence, which is not evidence.
OnFailure=kubelab-notify@%n.service
# Ship reads what capture staged; running it first would ship stale or
# missing data. This ordering constraint is declared here so it holds
# regardless of how a trigger invokes either unit.
After={{ node_backup_capture_service_name }}
# Part 4 settles the Requires=/Wants= question #1179 deferred: `Wants=`, so
# ONE timed unit drives the whole cycle. The timer starts ship, `Wants=` pulls
# capture in, `After=` runs it first. Timing capture instead would leave ship
# untriggered, because `After=` orders and never starts.
#
# `Wants=` and not `Requires=`: on a failed capture, `Requires=` would stop
# ship before it ran and the journal would show a unit that never started.
# `Wants=` lets ship run and REFUSE on the missing sentinel (#1179), which
# says "capture did not COMPLETE; refusing to ship a partial backup" in the
# log of the unit an operator is actually looking at.
Wants={{ node_backup_capture_service_name }}

[Service]
Type=oneshot
# A systemd service has no HOME unless User= sets one or it is declared here.
# restic needs it (or XDG_CACHE_HOME) to place its local metadata cache —
# without it, every run fails immediately with "unable to locate cache
# directory", after successfully reaching R2. Root, because these units carry
# no User= and run as root like every other oneshot in this role.
Environment=HOME=/root
ExecStart={{ node_backup_ship_script_path }}{{ ' --check' if node_backup_check else '' }}
{% if node_backup_memory_max %}
MemoryMax={{ node_backup_memory_max }}
MemorySwapMax={{ node_backup_memory_swap_max }}
{% endif %}
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal

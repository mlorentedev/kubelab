  {
    "key": "infra-dns-rpi4-resolves-staging",
    "name": "Infra · DNS · RPi4 resolves staging",
    "type": "dns",
    "url": "https://",
    "hostname": "staging.kubelab.live",
    "port": 53,
    "interval": 120,
    "maxretries": 3,
    "method": "GET",
    "keyword": null,
    "ignoreTls": false,
    "upsideDown": false,
    "accepted_statuscodes": [
      "200-299"
    ],
    "description": "Resolution, not liveness. The rpi4 ping monitor stayed GREEN through the 2026-08-22 outage because the host was never down - Docker had restored CoreDNS before tailscaled assigned its address, the health-port bind failed, and that dropped the container's whole port publication including 5353:53. Pi-hole lost its upstream and staging stopped resolving for ~90 minutes with three green signals covering it. This asks the only question that would have failed: does rpi4 answer for a staging name? SSOT: networking.nodes.rpi4.tailscale_ip.",
    "active": true,
    "httpBodyEncoding": null,
    "maxredirects": 10,
    "notificationIDList": [
      1
    ],
    "parent": null,
    "tags": [
      "infra",
      "dns"
    ],
    "dns_resolve_server": "100.64.0.10",

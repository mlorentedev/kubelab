    {
      "id": 6,
      "title": "Source freshness",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "forge-stats"
      },
      "description": "When each source was last read in full. A source that cannot be read keeps its last time, so a stale row here is a forge that is not answering, never an empty one.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "forge-stats"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT\n  forge,\n  owner || '/' || repo AS source,\n  source_reachable AS reachable,\n  as_of AS \"last full read\",\n  round(extract(epoch FROM now() - as_of) / 60) AS \"minutes since read\",\n  last_attempt_at AS \"last attempt\"\nFROM forge_stats\nORDER BY \"minutes since read\" DESC NULLS FIRST",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "minutes since read",
            "desc": true
          }
        ]
      }
    }

  "panels": [
    {
      "id": 1,
      "title": "Items closed per day",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "forge-stats"
      },
      "description": "Closed items by the day of their last update. The read model keeps no closed_at, so a comment on a closed item moves it to the day of the comment; the daily count is an approximation of throughput, not a ledger.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "forge-stats"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(updated_at, 1d), count(*) AS closed\nFROM forge_stats\nWHERE state = 'closed' AND $__timeFilter(updated_at)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Open items by time since last update",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "forge-stats"
      },
      "description": "Queue age. The read model keeps no created_at, so the age is time since the item was last updated, not since it was opened.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "forge-stats"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT bucket, count(*) AS items\nFROM (\n  SELECT CASE\n    WHEN now() - updated_at < interval '7 days' THEN '1 - under 7 days'\n    WHEN now() - updated_at < interval '30 days' THEN '2 - 7 to 30 days'\n    WHEN now() - updated_at < interval '90 days' THEN '3 - 30 to 90 days'\n    ELSE '4 - over 90 days'\n  END AS bucket\n  FROM forge_stats\n  WHERE state = 'open'\n) AS aged\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {

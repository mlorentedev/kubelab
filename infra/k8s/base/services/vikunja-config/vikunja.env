# Vikunja environment, generated into the `vikunja-config` ConfigMap.
#
# This lives in a file rather than inline in `services/vikunja.yaml` for one
# reason: `configMapGenerator` appends a content hash to the object name, so
# editing a value here rolls the Deployment. Env vars are injected at
# container start and Vikunja re-reads none of them, so a plain ConfigMap
# changes, Argo CD reports Synced/Healthy, and the running pod keeps the old
# value indefinitely -- a silent no-op (lesson-404, #1446). Every manual
# `kubectl rollout restart` this session was working around exactly this.
#
# Base = staging values (repo convention); prod overrides a subset via
# overlays/prod/vikunja-config/vikunja.env with configMapGenerator
# behavior: merge (same pattern as grafana-alerting).
VIKUNJA_SERVICE_PUBLICURL=https://tasks.staging.kubelab.live/
# Close public self-registration (SEC-VIKUNJA-001, #1568). `tasks.kubelab.live`
# has a public Cloudflare record, and ADR-066 D3 deliberately keeps Traefik
# ForwardAuth OFF so REST callers and n8n webhooks reach the API with a Bearer
# token -- correct, and exactly why the registration door has to close at the
# application layer instead. Nothing declared this key before, so Vikunja's own
# default (`true`) applied and `POST /api/v1/register` answered 400 on prod.
#
# This does NOT disable local login, and it does NOT affect OIDC: `RegisterUser`
# checks this flag, while the OIDC path `getOrCreateUser` checks nothing and
# keeps provisioning users from Authelia on first login. So there is no lockout
# mode here, and local login stays as break-glass -- the same posture as Argo
# CD's apiKey-only `admin`. Disabling local auth outright is a separate call.
VIKUNJA_SERVICE_ENABLEREGISTRATION=false
VIKUNJA_DATABASE_TYPE=postgres
VIKUNJA_DATABASE_HOST=postgres
VIKUNJA_DATABASE_PORT=5432
VIKUNJA_DATABASE_USER=vikunja
VIKUNJA_DATABASE_DATABASE=vikunja
VIKUNJA_DATABASE_MAXOPENCONNECTIONS=20
VIKUNJA_DATABASE_MAXIDLECONNECTIONS=5
# The storage backend toggle is files.type ("local"/"s3") -- there is no
# files.s3.enabled key in Vikunja. A prior VIKUNJA_FILES_S3_ENABLED here was
# a silent no-op (viper ignores unrecognized keys): Vikunja stayed on local
# storage the whole time regardless of its value. See ADR-066 amendment.
VIKUNJA_FILES_TYPE=s3
# Mirrors apps.services.core.vikunja.storage.s3_endpoint in common.yaml.
# Account ID is not a secret (same account as the PVC-backup R2 bucket) --
# R2's S3 endpoint embeds it in the hostname, unlike AWS S3.
VIKUNJA_FILES_S3_ENDPOINT=https://76967f5ede1ce50efce34d90b7e94958.r2.cloudflarestorage.com
# Separate bucket + separate bucket-scoped R2 token from prod's
# `kubelab-vikunja`, so a staging credential cannot read or write prod's data.
VIKUNJA_FILES_S3_BUCKET=kubelab-vikunja-staging
VIKUNJA_FILES_S3_REGION=auto
VIKUNJA_AUTH_OPENID_ENABLED=true
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_NAME=Authelia
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_AUTHURL=https://auth.staging.kubelab.live
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_CLIENTID=vikunja-oidc

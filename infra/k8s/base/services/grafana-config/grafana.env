# Grafana environment, generated into the `grafana-config` ConfigMap.
#
# This lives in a file rather than inline in `services/grafana.yaml` for one
# reason: `configMapGenerator` appends a content hash to the object name, so
# editing a value here rolls the Deployment. Env vars are injected at container
# start and Grafana re-reads none of them, so a plain ConfigMap changes, Argo CD
# reports Synced/Healthy, and the running pod keeps the old value indefinitely
# — a silent no-op. That is the failure the Authelia gotcha in CLAUDE.md
# describes, and it bit the role mapping below (#951, #1446).
#
# Values here are staging's. The prod overlay patches this object by name in
# `overlays/prod/patches.yaml`; the hash is computed after patching, so each
# environment gets its own.

GF_SERVER_ROOT_URL=https://grafana.staging.kubelab.live
GF_AUTH_ANONYMOUS_ENABLED=false

# The email a FRESH install gives its admin row (id 1), the break-glass account.
# Mirrors `apps.services.security.authelia.break_glass.grafana.email` in
# common.yaml; `tests/test_grafana_breakglass_account.py` fails on a mismatch.
# An existing install ignores it: `make grafana-admin-reconcile` sets it there.
# No Authelia user has this email, so no SSO login can adopt the account (#951).
GF_SECURITY_ADMIN_EMAIL=breakglass@kubelab.live

# One door (AUTH-004): Grafana signs users in through Authelia's OIDC, never
# through the ForwardAuth headers. The route keeps the `authelia` middleware as a
# perimeter, but Grafana no longer trusts its `Remote-User` header.
#
# While the auth proxy was on, every request through the route arrived with
# `Remote-User` and Grafana logged the user in from that header before its login
# page rendered. The proxy maps no role, so every account got the default,
# Viewer, and the OAuth role mapping below never ran: `operator`, in `admins`,
# was Viewer in both environments (measured 2026-09-24).
GF_AUTH_PROXY_ENABLED=false

# Authelia OIDC: the only interactive login. AUTO_LOGIN sends /login straight
# to the IdP, so the session is Authelia's and nobody picks a door.
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=KubeLab IDP
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=grafana
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email groups
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://auth.staging.kubelab.live/api/oidc/authorization
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://auth.staging.kubelab.live/api/oidc/token
GF_AUTH_GENERIC_OAUTH_API_URL=https://auth.staging.kubelab.live/api/oidc/userinfo
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH=groups
# AUTH-002 (#951): the role comes from the `groups` claim, `admins` → Admin,
# anyone else → Viewer, as Argo CD's `g, admins, role:admin` does.
#
# Grafana syncs this role on every OAuth login. It evaluates the path on the ID
# token first and moves on to UserInfo (API_URL) only when the result is empty,
# and Authelia 4.39 puts `groups` in UserInfo, NOT in the ID token. So the path
# must return null when `groups` is absent: a trailing `|| 'Viewer'` would answer
# from the ID token and UserInfo would never be read. It must ALSO return null for
# an EMPTY list (lesson-461): when the path finds nothing in a source, Grafana 13.0.2
# evaluates it again on `{"groups": []}`, a hardcoded empty list (`searchRole`).
# A path answering 'Viewer' for `[]` sets the role on the ID token, and UserInfo is
# never read: every SSO user was Viewer in staging
# on 2026-09-24. Hence `length(groups || [])`, which is also safe when `groups` is
# absent. Backticks: a bare `null` is a field name in JMESPath, not the literal.
# tests/test_access_review.py replays Grafana's two searches with a JMESPath engine.
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=length(groups || `[]`) > `0` && (contains(groups, 'admins') && 'Admin' || 'Viewer') || `null`
GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=name
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_GENERIC_OAUTH_AUTO_LOGIN=true

# MIGRATION, remove once every account is adopted (AUTH-004). Grafana's OAuth
# finds a returning user only by the OAuth link it stored at signup, or by email
# with this flag. It never looks up by login (13.0.2, authn/clients/oauth.go).
# Every account here was created by the auth proxy and has no OAuth link, so
# without the flag the first OAuth login tries to create `operator` again, hits
# the existing login, and fails with `user sync failed`. With it, the login
# matches the account by email and stores the link, and later logins use the link.
# Safe while it lasts: Authelia's users file is declared by the operator, no user
# can change their own email, and CI requires every identity to have a distinct
# one (tests/test_admin_identity_ssot.py).
GF_AUTH_OAUTH_ALLOW_INSECURE_EMAIL_LOOKUP=true

GF_LOG_MODE=console
GF_LOG_LEVEL=info

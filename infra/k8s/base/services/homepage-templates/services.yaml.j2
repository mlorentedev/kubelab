{# Homepage services.yaml — Generated from common.yaml SSOT.
   Run `make sync-homepage` to regenerate. Do NOT edit services.yaml directly. #}
{% set stg = "staging." + global.base_domain %}
{% set gp = 61208 %}
{% set n = nodes %}
{# ── DIAGRAMS (tables + SVGs, injected by custom.js) ── #}
- IP Reference:
    - placeholder:
        icon: mdi-table
- Topology:
    - placeholder:
        icon: mdi-map-marker-path
- DNS Map:
    - placeholder:
        icon: mdi-table
- DNS Resolution:
    - placeholder:
        icon: mdi-dns
- GitOps:
    - placeholder:
        icon: mdi-source-branch
- Request Path:
    - placeholder:
        icon: mdi-arrow-decision
- Secret Flow:
    - placeholder:
        icon: mdi-key-chain
- Deploy Pipeline:
    - placeholder:
        icon: mdi-rocket-launch
- Tech Stack:
    - placeholder:
        icon: mdi-tools
{# ── SERVICES (tables injected by custom.js) ── #}
- Shared:
    - placeholder:
        icon: mdi-share-variant
- Staging:
    - placeholder:
        icon: mdi-server
- Prod:
    - placeholder:
        icon: mdi-cloud
{# ── INFRA (widgets + hardware monitoring) ── #}
- Network:
    - Cloudflare:
        icon: si-cloudflare
        href: https://dash.cloudflare.com
        description: DNS analytics
        widget:
          type: customapi
          url: https://api.cloudflare.com/client/v4/graphql
          method: POST
          headers:
            Authorization: "Bearer {%raw%}{{HOMEPAGE_VAR_CLOUDFLARE_TOKEN}}{%endraw%}"
            Content-Type: application/json
          requestBody:
            # DASH-DT-010: static far-past date_geq + orderBy date_DESC returns the most
            # recent daily group without baking today's date into the committed file
            # (no daily drift across validate-sync).
            # yamllint disable-line rule:line-length
            query: '{ viewer { zones(filter: {zoneTag: "{{ cloudflare_zone_id }}"}) { httpRequests1dGroups(limit: 1, filter: {date_geq: "2020-01-01"}, orderBy: [date_DESC]) { sum { requests threats } } } } }'
          mappings:
            - field: data.viewer.zones.0.httpRequests1dGroups.0.sum.requests
              label: Requests
              format: number
            - field: data.viewer.zones.0.httpRequests1dGroups.0.sum.threats
              label: Threats
              format: number
    - Uptime Kuma:
        icon: si-uptimekuma
        href: https://{{ services.observability.uptime_kuma.domain }}
        description: RPi3 · Status
        widget:
          type: uptimekuma
          url: http://{{ n.rpi3.tailscale_ip }}:{{ services.observability.uptime_kuma.default_port }}
          slug: kubelab
    - Traefik Stg:
        icon: si-traefikproxy
        href: https://traefik.{{ stg }}/dashboard/
        description: Staging proxy
        widget:
          type: traefik
          url: http://traefik.kube-system.svc:9000
    - Traefik Prod:
        icon: si-traefikproxy
        href: https://{{ services.core.traefik.domain }}/dashboard/
        description: Prod proxy
        ping: https://{{ services.core.traefik.domain }}/dashboard/
    - CoreDNS (RPi4):
        icon: mdi-dns
        description: RPi4 · Staging DNS
        ping: http://{{ n.rpi4.tailscale_ip }}:8080
- Nodes:
{% for node_name, node in node_list %}
    - "{{ node_name }}":
        icon: {{ node.icon }}
        description: "{{ node.description }}"
{% if node.glances %}
        widget:
          type: glances
          url: http://{{ node.ip }}:{{ gp }}
{% if node.glances_version is defined %}
          version: {{ node.glances_version }}
{% else %}
          version: 4
{% endif %}
          metric: info
{% elif node.ping_url is defined %}
        ping: {{ node.ping_url }}
{% endif %}
{% endfor %}
{# ── AI FLEET & AUTOMATIONS (Neural Hive, n8n workflows & Telemetry) ── #}
- Agents:
    - Curator Agent:
        icon: mdi-brain
        href: https://github.com/mlorentedev/knowledge
        description: Neural Hive · Memory & ADR Synthesis
        ping: https://github.com/mlorentedev/knowledge
    - SRE Triage Agent:
        icon: mdi-robot
        href: https://github.com/mlorentedev/kubelab/blob/master/docs/adr/adr-064-agentic-observability-and-auto-triage.md
        description: Reactive LogQL & Anomaly Classifier
        ping: https://grafana.{{ global.base_domain }}
    - GitOps Delivery Agent:
        icon: si-argo
        href: https://argo.{{ global.base_domain }}
        description: Automated Release Attestation & Promotion
        ping: https://argo.{{ global.base_domain }}
- Workflows:
    - SRE Incident Auto-Triage:
        icon: si-n8n
        href: https://n8n.{{ global.base_domain }}
        description: Alertmanager Webhook -> Log Slicing -> Slack
        ping: https://n8n.{{ global.base_domain }}
    - Secret Expiry & R2 Backup:
        icon: mdi-shield-refresh
        href: https://status.{{ global.base_domain }}
        description: Proactive Backup & Credential Rotator
        ping: https://status.{{ global.base_domain }}
    - Spoke Reconciliation:
        icon: mdi-sync
        href: https://argo.{{ global.base_domain }}
        description: K8s Spoke Topology Drift Healing
        ping: https://argo.{{ global.base_domain }}
- Telemetry:
    - Loki Telemetry API:
        icon: si-grafana
        href: https://grafana.{{ global.base_domain }}/explore
        description: LogQL Cluster Telemetry & Tracebacks
        ping: https://grafana.{{ global.base_domain }}
    - Health & SLO Monitor:
        icon: si-uptimekuma
        href: https://status.{{ global.base_domain }}
        description: Live Multi-Burn-Rate SLO Engine
        ping: https://status.{{ global.base_domain }}
    - Codebase Activity:
        icon: si-github
        href: https://github.com/mlorentedev/kubelab
        description: L0 Infrastructure Codebase
        widget:
          type: customapi
          url: https://api.github.com/repos/mlorentedev/kubelab
          refreshInterval: 300000
          headers:
            Accept: application/vnd.github.v3+json
            Authorization: "Bearer {%raw%}{{HOMEPAGE_VAR_GITHUB_TOKEN}}{%endraw%}"
          mappings:
            - field: open_issues_count
              label: Issues
              format: number
            - field: stargazers_count
              label: Stars
              format: number

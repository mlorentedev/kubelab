{#
  What a product's contract `resources:` claims (RES-HOST-001 D3, D4), read from the
  env's contract snapshot and never from values. One PVC per volume claim, on the
  cluster's default StorageClass, and one CronJob per job claim. The CronJob runs
  the app's image with the app's ConfigMap, Secret and pull Secret; the local-path
  volume pins it to the node that holds the data.
#}
{% for app in apps %}
{% for volume in app.volumes %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ volume.claim }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: {{ app.name }}
    app.kubernetes.io/part-of: kubelab
    app.kubernetes.io/managed-by: toolkit
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ volume.size }}
{% endfor %}
{% for job in app.jobs %}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ app.name }}-{{ job.name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: {{ app.name }}
    app.kubernetes.io/component: cronjob
    app.kubernetes.io/part-of: kubelab
    app.kubernetes.io/managed-by: toolkit
spec:
  schedule: {{ job.schedule | tojson }}
  # The contract states its schedule in UTC.
  timeZone: Etc/UTC
  concurrencyPolicy: Forbid
  jobTemplate:
    spec:
      backoffLimit: 2
      activeDeadlineSeconds: {{ job.active_deadline_seconds }}
      template:
        metadata:
          labels:
            app.kubernetes.io/name: {{ app.name }}
            app.kubernetes.io/component: cronjob
            app.kubernetes.io/part-of: kubelab
        spec:
          restartPolicy: Never
{% if job.volume.fs_group %}
          securityContext:
            fsGroup: {{ job.volume.fs_group }}
            fsGroupChangePolicy: OnRootMismatch
{% endif %}
          volumes:
            - name: {{ job.volume.name }}
              persistentVolumeClaim:
                claimName: {{ job.volume.claim }}
{% if app.image_pull_secret %}
          imagePullSecrets:
            - name: {{ app.image_pull_secret }}
{% endif %}
          containers:
            - name: {{ job.name }}
              image: {{ app.image }}
              imagePullPolicy: {{ app.image_pull_policy }}
              command: {{ job.command | tojson }}
              envFrom:
                - configMapRef:
                    name: {{ app.name }}-config
{% if app.has_secrets %}
                - secretRef:
                    name: {{ app.name }}-secrets
{% endif %}
              volumeMounts:
                - name: {{ job.volume.name }}
                  mountPath: {{ job.volume.mount_path }}
              resources:
                limits:
                  memory: {{ app.resources.memory_limit }}
                  cpu: "{{ app.resources.cpu_limit }}"
                requests:
                  memory: {{ app.resources.memory_request }}
                  cpu: "{{ app.resources.cpu_request }}"
{% endfor %}
{% endfor %}

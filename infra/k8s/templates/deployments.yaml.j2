{% for app in apps %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app.name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: {{ app.name }}
    app.kubernetes.io/part-of: kubelab
    app.kubernetes.io/managed-by: toolkit
spec:
  replicas: 1
  strategy:
{% if app.volumes %}
    # A surge pod cannot open a database the old pod still holds, nor mount an RWO claim from another node.
    type: Recreate
{% else %}
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
{% endif %}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ app.name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ app.name }}
        app.kubernetes.io/part-of: kubelab
{% if app.jobs %}
        # Keeps the Service off the CronJob pods, which carry the same name label.
        app.kubernetes.io/component: app
{% endif %}
    spec:
{% if app.fs_group %}
      securityContext:
        fsGroup: {{ app.fs_group }}
        fsGroupChangePolicy: OnRootMismatch
{% endif %}
{% if app.volumes %}
      volumes:
{% for volume in app.volumes %}
        - name: {{ volume.name }}
          persistentVolumeClaim:
            claimName: {{ volume.claim }}
{% endfor %}
{% endif %}
{% if app.image_pull_secret %}
      imagePullSecrets:
        - name: {{ app.image_pull_secret }}
{% endif %}
      containers:
        - name: {{ app.name }}
          image: {{ app.image }}
          imagePullPolicy: {{ app.image_pull_policy }}
          ports:
            - name: http
              containerPort: {{ app.port }}
              protocol: TCP
          envFrom:
            - configMapRef:
                name: {{ app.name }}-config
{% if app.has_secrets %}
            - secretRef:
                name: {{ app.name }}-secrets
{% endif %}
{% if app.health_path %}
          livenessProbe:
            httpGet:
              path: {{ app.health_path }}
              port: http
            initialDelaySeconds: 10
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: {{ app.readiness_path or app.health_path }}
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
{% endif %}
{% if app.volumes %}
          volumeMounts:
{% for volume in app.volumes %}
            - name: {{ volume.name }}
              mountPath: {{ volume.mount_path }}
{% endfor %}
{% endif %}
          lifecycle:
            preStop:
              sleep:
                seconds: 5
          resources:
            limits:
              memory: {{ app.resources.memory_limit }}
              cpu: "{{ app.resources.cpu_limit }}"
            requests:
              memory: {{ app.resources.memory_request }}
              cpu: "{{ app.resources.cpu_request }}"
{% endfor %}

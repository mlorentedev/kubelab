# The API's Atlas migrations (DATA-007). Both names carry a hash of the migration
# directory: a Job's spec is immutable, so a new migration needs a new Job, and an
# unchanged one applies as a no-op under kubectl and Argo CD alike. A Job and not
# an initContainer because the API must start while Postgres is down.
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: api-migrations-{{ migrations.hash }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: api-migrate
    app.kubernetes.io/part-of: kubelab
    app.kubernetes.io/managed-by: toolkit
data:
{% for name, content in migrations.files.items() %}
  {{ name }}: |
    {{ content | indent(4) }}
{% endfor %}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: api-migrate-{{ migrations.hash }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: api-migrate
    app.kubernetes.io/component: migration
    app.kubernetes.io/part-of: kubelab
    app.kubernetes.io/managed-by: toolkit
spec:
  backoffLimit: 6
  template:
    metadata:
      labels:
        app.kubernetes.io/name: api-migrate
        app.kubernetes.io/component: migration
        app.kubernetes.io/part-of: kubelab
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
      volumes:
        - name: migrations
          configMap:
            name: api-migrations-{{ migrations.hash }}
      containers:
        - name: atlas
          image: {{ migrations.image }}
          args:
            - migrate
            - apply
            - --dir
            - file:///migrations
            - --url
            # Expanded by the kubelet. The password is a URL-safe token (SecretKind.RANDOM_TOKEN).
            - postgres://{{ migrations.tenant }}:$(POSTGRES_TENANT_PASSWORD)@{{ migrations.host }}:{{ migrations.port }}/{{ migrations.tenant }}?sslmode=disable
          env:
            - name: POSTGRES_TENANT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: api-secrets
                  key: POSTGRES_TENANT_PASSWORD
          volumeMounts:
            - name: migrations
              mountPath: /migrations
              readOnly: true
          resources:
            limits:
              memory: 128Mi
              cpu: "0.2"
            requests:
              memory: 32Mi
              cpu: "0.02"

{% for app in apps %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ app.name }}-config
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: {{ app.name }}
    app.kubernetes.io/part-of: kubelab
    app.kubernetes.io/managed-by: toolkit
data:
{% for key, value in app.env_vars.items() | sort %}
{#- A value past yamllint's line length is folded at its spaces: `>-` joins the
    lines with one space each, so the value reads back unchanged. #}
{% if value | length > 100 and value == value | trim and "  " not in value and "\n" not in value %}
  {{ key }}: >-
    {{ value | wordwrap(100, break_long_words=False, break_on_hyphens=False, wrapstring="\n    ") }}
{% else %}
  {{ key }}: "{{ value }}"
{% endif %}
{% endfor %}
{% endfor %}

# PR-Agent's environment (TOOL-080, #1823), generated into the `pr-agent-config`
# ConfigMap via a `configMapGenerator` — the name carries a content hash, so an
# edit here rolls the Deployment (lesson-404, #1446).
#
# Prod only: there is no base or staging counterpart (proposal, "Out of scope:
# Staging"). Carried over from `.github/workflows/pr-agent.yml` /
# `.pr_agent.toml` (the GitHub-side contract) plus the settings the 2026-09-24
# lab measured (specs/TOOL-080-forge-pr-reviewer/verification.md, "Delivery" and
# "Scopes"). List-shaped values are the literal JSON-looking string — PR-Agent's
# own pydantic-settings parses it from the env var text, not from real YAML/JSON
# typing, the same as the workflow's `CONFIG__FALLBACK_MODELS`.

CONFIG__GIT_PROVIDER=gitea
GITEA__URL=https://gitea.kubelab.live
OPENAI__API_BASE=https://api.nan.builders/v1
# The chain is the reviewer pool's NaN members (harness/reviewer-pool.json,
# `provider: nan` with a `pr_agent.weight`), heaviest first and the pool's own
# order on a tie: the same models CI declares. Each model gets one 360 s
# attempt, so a review that fails on all three takes up to 18 minutes before
# `Failed to review PR` is logged and the TOOL-093 alert fires. The pool's
# Anthropic members are not here: this server reviews through one api_base and
# one custom_llm_provider for every model (lesson-596). glm runs at the
# default reasoning effort, not the pool's `low`: PR-Agent's
# CONFIG__REASONING_EFFORT is one value for the whole chain.
CONFIG__MODEL=openai/mimo-v2.6-flash
CONFIG__FALLBACK_MODELS=["openai/deepseek-v4-flash", "openai/glm5.3-flash"]
CONFIG__CUSTOM_MODEL_MAX_TOKENS=200000
# The prompt cap, stated beside the model budget as the GitHub workflow does.
# PR-Agent limits every prompt to `config.max_model_tokens` whatever the budget
# above says, and its default is 32000 (v0.45.0 configuration.toml), so without
# this line the forge reviewed a third-sized diff and skipped the rest.
CONFIG__MAX_MODEL_TOKENS=200000
CONFIG__PUBLISH_OUTPUT_PROGRESS=false
# The budget settings of `.pr_agent.toml`, repeated because the forge reviews
# other repositories, which do not carry kubelab's toml: streaming, so NaN's
# Cloudflare front never cuts a long review at 125 s; one 360 s attempt per model
# (#1909); and room for more than three findings before a review is reported
# partial.
CONFIG__RETRY_SAME_MODEL_ON_TIMEOUT=false
CONFIG__NUM_RETRIES=0
CONFIG__AI_TIMEOUT=360
LITELLM__CUSTOM_LLM_PROVIDER=openai
LITELLM__FORCE_STREAMING_CUSTOM_LLM_PROVIDER=openai
LITELLM__FORCE_STREAMING_API_BASE_SUBSTRINGS=["api.nan.builders"]
PR_REVIEWER__NUM_MAX_FINDINGS=5

# Upstream's default PR_COMMANDS also runs `/describe` (rewrites the PR title
# and body) and `/improve`; `pr-agent.yml` turns both off on GitHub, and AC4
# requires the same restraint here.
GITEA__PR_COMMANDS=["/review"]
# Upstream ignores a push (`synchronized`) unless this is set, so without it a
# push would go unreviewed entirely.
GITEA__HANDLE_PUSH_TRIGGER=true
GITEA__PUSH_COMMANDS=["/review"]

# One comment per PR, edited on every push, rather than upstream's default of a
# second "updated" comment alongside the edited one (measured, verification.md
# "Delivery": run A vs run B).
PR_REVIEWER__PERSISTENT_COMMENT=true
PR_REVIEWER__FINAL_UPDATE_MESSAGE=false

# Labelling needs write. For a read-only reviewer both label calls returned 403
# on every review in the lab (verification.md, "Scopes") — harmless, but an
# error on every single run.
PR_REVIEWER__ENABLE_REVIEW_LABELS_EFFORT=false
PR_REVIEWER__ENABLE_REVIEW_LABELS_SECURITY=false

# Upstream default, pinned so the property it carries is declared and tested:
# AGENTS.md enters the prompt from the default branch only, never from the PR
# head under review (gitea_provider.py:885, verification.md).
CONFIG__REPO_CONTEXT_FROM_DEFAULT_BRANCH=true

# GITEA__REPO_SETTING is deliberately ABSENT (AC4). Setting it would make the
# provider read a repository .pr_agent.toml at the PR's HEAD SHA, letting a PR
# author rewrite the reviewer's own configuration in the change under review.

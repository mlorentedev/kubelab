# Prod overrides for the base `vikunja-config` ConfigMap (base/services/
# vikunja-config/vikunja.env) -- merged in via configMapGenerator
# behavior: merge in overlays/prod/kustomization.yaml. Same pattern as
# grafana-alerting: only these keys change, everything else carries through
# from the base untouched.
VIKUNJA_SERVICE_PUBLICURL=https://tasks.kubelab.live/
VIKUNJA_SERVICE_CUSTOMLOGOURL=https://assets.kubelab.live/brand/logo.png
VIKUNJA_SERVICE_CUSTOMLOGOURLDARK=https://assets.kubelab.live/brand/logo.png
VIKUNJA_AUTH_OPENID_PROVIDERS_AUTHELIA_AUTHURL=https://auth.kubelab.live
# Separate bucket + separate bucket-scoped R2 token from staging's
# `kubelab-vikunja-staging` (base default) -- credential-blast-radius
# isolation between environments.
VIKUNJA_FILES_S3_BUCKET=kubelab-vikunja

{
  "id": "d2000000-0000-4000-8000-000000000001",
  "name": "multi-forge-sync",
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "IDP-035: Ingest GitHub and Gitea webhooks, validate HMAC SHA256 signatures (fail-closed), search task by key, transition Vikunja task state, and append PR URLs."
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "multi-forge-sync",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Webhook Ingress",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-400, 0],
      "webhookId": "w2000000-0000-4000-8000-000000000001"
    },
    {
      "parameters": {
        "jsCode": "// Extract event info, validate HMAC SHA-256 signature (fail-closed), and parse task key\nconst body = $json.body || $json;\nconst headers = $json.headers || {};\nconst action = body.action || 'push';\nconst pr = body.pull_request || {};\nconst isMerged = Boolean(pr.merged);\nconst title = pr.title || body.head_commit?.message || '';\nconst branch = pr.head?.ref || body.ref || '';\nconst prUrl = pr.html_url || '';\n\n// Match task key pattern (e.g. IDP-035, GITOPS-003, AREA-123)\nconst match = (title + ' ' + branch).toUpperCase().match(/\\b([A-Z]{2,10})-(\\d+)\\b/);\nconst taskKey = match ? match[0] : null;\nconst taskId = match ? parseInt(match[2], 10) : null;\n\n// HMAC validation: strictly fail-closed\nconst sig = headers['x-hub-signature-256'] || headers['x-gitea-signature'] || '';\nconst secret = $env.FORGE_WEBHOOK_SECRET || '';\nlet isValidSig = false;\n\nif (secret && sig) {\n  const crypto = require('crypto');\n  const hmac = crypto.createHmac('sha256', secret);\n  hmac.update(typeof body === 'string' ? body : JSON.stringify(body));\n  const hexDigest = hmac.digest('hex');\n  isValidSig = (sig === 'sha256=' + hexDigest || sig === hexDigest);\n}\n\nlet targetBucket = 'In Progress';\nlet isDone = false;\nif (action === 'closed' && isMerged) {\n  targetBucket = 'Done';\n  isDone = true;\n} else if (['opened', 'synchronize', 'reopened'].includes(action)) {\n  targetBucket = 'In Review';\n  isDone = false;\n}\n\nreturn [{\n  json: {\n    taskKey: taskKey,\n    taskId: taskId,\n    action: action,\n    isMerged: isMerged,\n    isDone: isDone,\n    targetBucket: targetBucket,\n    prUrl: prUrl,\n    title: title,\n    hasTask: Boolean(taskKey && isValidSig),\n    isValidSig: isValidSig\n  }\n}];"
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Parse Forge Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-180, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.hasTask }}",
              "value2": true
            }
          ]
        }
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Has Task Key & Valid Sig?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [40, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://vikunja:3456/api/v1/tasks/all?s={{ $json.taskKey }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.VIKUNJA_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "continueOnFail": true
        }
      },
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Find Vikunja Task by Key",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, -100]
    },
    {
      "parameters": {
        "jsCode": "// Resolve matched task ID from search results or fallback to numeric index\nconst searchResults = Array.isArray($json) ? $json : ($json.data || []);\nconst event = $('Parse Forge Event').first().json;\nlet resolvedTaskId = event.taskId;\n\nif (searchResults.length > 0 && searchResults[0].id) {\n  resolvedTaskId = searchResults[0].id;\n}\n\nreturn [{\n  json: {\n    ...event,\n    taskId: resolvedTaskId\n  }\n}];"
      },
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "Extract Matched Task ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://vikunja:3456/api/v1/tasks/{{ $json.taskId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.VIKUNJA_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ done: $json.isDone }) }}",
        "options": {
          "continueOnFail": true
        }
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Update Vikunja Task State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, -100]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=http://vikunja:3456/api/v1/tasks/{{ $json.taskId }}/comments",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.VIKUNJA_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ comment: '🔗 Linked PR: ' + $json.prUrl + ' (' + $json.action + ')' }) }}",
        "options": {
          "continueOnFail": true
        }
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Append PR URL Comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://apprise:8000/notify/kubelab",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tag: 'deploy', title: '📋 Forge Sync: ' + $json.taskKey + ' -> ' + $json.targetBucket, body: 'PR: ' + $json.prUrl + ' (' + $json.action + ')', type: 'info' }) }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Notify #dev-activity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'ok', taskKey: $json.taskKey, targetBucket: $json.targetBucket }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1240, 0]
    }
  ],
